---
/**
 * The /app/crm/deals screen, mirrored from the app:
 *
 *   web/src/app/app/crm/deals/page.tsx      PageTopbar, StatStrip, the Board (280px columns on a 12px
 *                                           gap), BoardColumn (h-9 header, open value row), DealCard
 *                                           (name, contact, value and expected close), and the deal
 *                                           dialog a card click opens (480px, scrim with a 2px blur,
 *                                           8px lift over 160ms)
 *   web/src/components/layout/Page.tsx       PageTopbar / StatStrip / SectionBar
 *   web/src/components/ui/field.tsx          Label / TextInput
 *   web/src/components/ui/DatePicker.tsx     the Expected close trigger
 *
 * Demo: the cursor clicks the Stratech card, the deal dialog opens, then it
 * closes from the dialog's own X.
 */
import DemoCursor from './DemoCursor.astro';

// Money formatter, mirrors formatMoney() in deals/page.tsx.
const money = (n: number) =>
  new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(n);

type Deal = { name: string; value: number; contact: string; close?: string; status?: 'won'; key?: string };
type Stage = { name: string; color: string; deals: Deal[] };

const stages: Stage[] = [
  {
    name: 'Qualified',
    color: '#0ea5e9',
    deals: [
      { name: 'Stratech', value: 45000, contact: 'rowan@stratech.io', close: 'Jul 15', key: 'stratech' },
      { name: 'Northwind', value: 8500, contact: 'ravi@northwind.dev', close: 'Jul 30' },
      { name: 'Spruce Bio', value: 6200, contact: 'lena@sprucebio.com' },
    ],
  },
  {
    name: 'Proposal',
    color: '#8b5cf6',
    deals: [
      { name: 'Helio', value: 24000, contact: 'founder@helio.gen', close: 'Jun 28' },
      { name: 'Tidewater Labs', value: 15500, contact: 'ops@tidewater.io', close: 'Jul 8' },
    ],
  },
  {
    name: 'Negotiation',
    color: '#f59e0b',
    deals: [
      { name: 'Brightfold', value: 31000, contact: 'priya@brightfold.com', close: 'Jun 20' },
      { name: 'Maple & Co', value: 9800, contact: 'sam@mapleco.com', close: 'Jun 24' },
    ],
  },
  {
    name: 'Won',
    color: '#10b981',
    deals: [{ name: 'Cobalt Group', value: 42000, contact: 'ceo@cobaltgroup.com', close: 'Jun 2', status: 'won' }],
  },
];

const allDeals = stages.flatMap((s) => s.deals);
const openValue = allDeals.filter((d) => d.status !== 'won').reduce((a, d) => a + d.value, 0);
const openCount = allDeals.filter((d) => d.status !== 'won').length;
const wonValue = allDeals.filter((d) => d.status === 'won').reduce((a, d) => a + d.value, 0);
// The app's stage summary counts and sums open deals only (pg_crm.go).
const stageOpen = (s: Stage) => s.deals.filter((d) => d.status !== 'won');
const stageTotal = (s: Stage) => stageOpen(s).reduce((a, d) => a + d.value, 0);

const stats = [
  { label: 'Open', value: String(openCount), sub: 'open deals', last: false },
  { label: 'Pipeline value', value: money(openValue), sub: 'open · server total', last: false },
  { label: 'Won', value: money(wonValue), sub: 'closed won', last: false },
  { label: 'Stages', value: String(stages.length), sub: 'on this pipeline', last: true },
];

const ic = {
  user: '<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>',
  dollar: '<circle cx="12" cy="12" r="10"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 18V6"/>',
  calendar: '<path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/>',
  trophy: '<path d="M10 14.66v1.626a2 2 0 0 1-.976 1.696A5 5 0 0 0 7 21.978"/><path d="M14 14.66v1.626a2 2 0 0 0 .976 1.696A5 5 0 0 1 17 21.978"/><path d="M18 9h1.5a1 1 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M6 9a6 6 0 0 0 12 0V3a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1z"/><path d="M6 9H4.5a1 1 0 0 1 0-5H6"/>',
  trash: '<path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>',
  x: '<path d="M18 6 6 18"/><path d="m6 6 12 12"/>',
};
---
<div class="cd relative w-full flex flex-col bg-white text-slate-900 overflow-hidden" style="min-height:560px;" data-demo="cd">
  <!-- PageTopbar -->
  <div class="h-12 px-5 border-b border-slate-200 flex items-center gap-3 shrink-0 bg-white">
    <span class="text-[10px] uppercase tracking-[0.14em] text-slate-400 font-medium">Deals</span>
    <div class="h-4 w-px bg-slate-200"></div>
    <span class="text-[12.5px] text-slate-600 truncate">Sales pipeline</span>

    <div class="ml-auto flex items-center gap-1.5">
      <div class="inline-flex rounded-md bg-slate-100 p-0.5 gap-0.5">
        <span class="h-6 px-2 rounded text-[11px] font-medium inline-flex items-center gap-1.5 text-slate-500">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18"/></svg>
          Table
        </span>
        <span class="h-6 px-2 rounded text-[11px] font-medium inline-flex items-center gap-1.5 bg-white text-slate-900 shadow-sm">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>
          Board
        </span>
      </div>
      <button type="button" class="h-7 px-2.5 rounded-md border border-slate-200 text-[12px] text-slate-700 inline-flex items-center gap-1.5 min-w-0">
        <span class="truncate max-w-[110px] @md:max-w-[200px]">Sales pipeline</span>
        <span class="text-slate-400">▾</span>
      </button>
      <div class="h-7 px-2 rounded-md border border-slate-200 bg-white flex items-center gap-1.5">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-slate-400" stroke-linecap="round" stroke-linejoin="round"><path d="m21 21-4.34-4.34"/><circle cx="11" cy="11" r="8"/></svg>
        <span class="w-[120px] @md:w-[160px] h-5 inline-flex items-center text-[12px] text-slate-400">Search deals…</span>
      </div>
      <button type="button" class="h-7 px-2.5 rounded-md inline-flex items-center gap-1.5 text-[12px] font-medium bg-sky-600 text-white">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
        New deal
      </button>
    </div>
  </div>

  <!-- StatStrip -->
  <div class="grid border-b border-slate-200 shrink-0 bg-white grid-cols-2 @md:grid-cols-4">
    {stats.map((s) => (
      <div class={`group px-5 py-4 transition-colors ${!s.last ? 'border-r border-slate-200' : ''}`}>
        <div class="flex items-center gap-2">
          <span class="text-[10px] uppercase tracking-[0.14em] text-slate-400 font-medium">{s.label}</span>
        </div>
        <div class="text-[26px] text-slate-900 font-light leading-none mt-2 tabular-nums">{s.value}</div>
        <div class="text-[10px] text-slate-400 mt-1.5 font-mono truncate">{s.sub}</div>
      </div>
    ))}
  </div>

  <!-- SectionBar -->
  <div class="min-h-9 @md:h-9 px-5 py-1.5 @md:py-0 border-b border-slate-200/60 flex flex-wrap @md:flex-nowrap items-center gap-x-2.5 gap-y-1.5 shrink-0">
    <span class="text-[10px] uppercase tracking-[0.14em] text-slate-400 font-medium">{stages.length} stages</span>
  </div>

  <!-- Board (PageBody) -->
  <div class="flex-1 min-h-0 overflow-hidden px-5 py-5">
    <div class="grid gap-3 grid-flow-col auto-cols-[280px] overflow-hidden pb-2">
      {stages.map((stage) => (
        <div class="flex flex-col rounded-md min-h-[300px] max-h-[calc(900px-230px)] transition-colors bg-slate-50 border-slate-200 border">
          <div class="h-9 px-3 flex items-center gap-2 border-b border-slate-200 shrink-0">
            <span class="size-1.5 rounded-full shrink-0" style={`background-color:${stage.color};`}></span>
            <span class="text-[11px] uppercase tracking-[0.1em] font-semibold text-slate-700 truncate">{stage.name}</span>
            <span class="ml-auto font-mono text-[10.5px] text-slate-400 tabular-nums">{stageOpen(stage).length}</span>
          </div>
          {stageTotal(stage) > 0 && (
            <div class="px-3 py-1 border-b border-slate-200/60 bg-white shrink-0">
              <span class="text-[10.5px] text-emerald-700 font-mono tabular-nums">{money(stageTotal(stage))} open</span>
            </div>
          )}
          <div class="p-2 space-y-1.5 flex-1 overflow-y-auto">
            {stage.deals.map((d) => (
              <div class="cursor-pointer rounded-md bg-white border border-slate-200 px-2.5 py-2 transition-all [&.is-hover]:border-slate-300 [&.is-hover]:shadow-sm" data-deal={d.key}>
                <div class="flex items-center gap-1.5 mb-1">
                  <div class="text-[12px] font-medium text-slate-900 truncate flex-1">{d.name}</div>
                  {d.status === 'won' && <span class="text-[9.5px] uppercase tracking-[0.08em] font-semibold text-emerald-700">Won</span>}
                </div>
                <div class="flex items-center gap-1 text-[10.5px] text-slate-500 truncate mb-1.5">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0" stroke-linecap="round" stroke-linejoin="round" set:html={ic.user}></svg>
                  <span class="truncate">{d.contact}</span>
                </div>
                <div class="flex items-center gap-2 text-[10.5px]">
                  <span class="inline-flex items-center gap-1 text-emerald-600 font-mono tabular-nums">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ic.dollar}></svg>
                    {money(d.value)}
                  </span>
                  {d.close && (
                    <span class="inline-flex items-center gap-1 text-slate-400 ml-auto">
                      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ic.calendar}></svg>
                      {d.close}
                    </span>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- The deal dialog a card click opens -->
  <!-- Portaled to the body in the app: fixed over the whole window, centred on the screen. -->
  <div class="cd-react fixed inset-0 z-[110] flex items-center justify-center bg-slate-900/30 backdrop-blur-[2px] px-4" aria-hidden="true">
    <div class="cd-dialog w-full max-w-[480px] max-h-[calc(900px-2rem)] flex flex-col rounded-lg bg-white border border-slate-200 shadow-[0_24px_48px_-12px_rgba(15,23,42,0.18)] overflow-hidden">
      <div class="h-12 shrink-0 px-4 border-b border-slate-200 flex items-center gap-2.5">
        <div class="size-5 rounded bg-slate-100 text-slate-600 flex items-center justify-center">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ic.trophy}></svg>
        </div>
        <span class="text-[10px] uppercase tracking-[0.14em] text-slate-400 font-medium">Edit</span>
        <div class="h-4 w-px bg-slate-200"></div>
        <span class="text-[12.5px] text-slate-900 font-medium">Deal</span>
        <span class="ml-2 size-7 rounded-md text-slate-400 inline-flex items-center justify-center">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ic.trash}></svg>
        </span>
        <span class="ml-auto size-7 rounded-md text-slate-500 inline-flex items-center justify-center transition-colors [&.is-hover]:text-slate-900 [&.is-hover]:bg-slate-100" data-cd="close">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ic.x}></svg>
        </span>
      </div>

      <div class="px-4 py-4 space-y-3 min-h-0 overflow-y-auto">
        <div>
          <span class="text-[10px] uppercase tracking-[0.14em] text-slate-400 font-medium block mb-1.5">Deal name</span>
          <div class="h-7 px-2.5 rounded-md border border-sky-400 ring-2 ring-sky-100 bg-white text-[12.5px] text-slate-900 flex items-center w-full">Stratech</div>
        </div>
        <div class="grid grid-cols-1 @sm:grid-cols-2 gap-2">
          <div>
            <span class="text-[10px] uppercase tracking-[0.14em] text-slate-400 font-medium block mb-1.5">Stage</span>
            <div class="h-7 w-full px-2.5 rounded-md border border-slate-200 text-[12px] text-slate-700 inline-flex items-center gap-1.5">
              <span class="size-1.5 rounded-full shrink-0" style="background-color:#0ea5e9;"></span>
              <span class="truncate">Qualified</span>
              <span class="ml-auto text-slate-400">▾</span>
            </div>
          </div>
          <div>
            <span class="text-[10px] uppercase tracking-[0.14em] text-slate-400 font-medium block mb-1.5">Status</span>
            <div class="inline-flex rounded-md bg-slate-100 p-0.5 gap-0.5 w-full">
              <span class="flex-1 h-6 px-2 rounded text-[11px] font-medium transition-colors bg-white text-slate-900 shadow-sm">Open</span>
              <span class="flex-1 h-6 px-2 rounded text-[11px] font-medium transition-colors text-slate-500">Won</span>
              <span class="flex-1 h-6 px-2 rounded text-[11px] font-medium transition-colors text-slate-500">Lost</span>
            </div>
          </div>
        </div>
        <div class="grid grid-cols-1 @sm:grid-cols-3 gap-2">
          <div class="@sm:col-span-2">
            <span class="text-[10px] uppercase tracking-[0.14em] text-slate-400 font-medium block mb-1.5">Value</span>
            <div class="h-7 px-2.5 rounded-md border border-slate-200 bg-white text-[12.5px] text-slate-900 flex items-center w-full">45000</div>
          </div>
          <div>
            <span class="text-[10px] uppercase tracking-[0.14em] text-slate-400 font-medium block mb-1.5">Currency</span>
            <div class="h-7 px-2.5 rounded-md border border-slate-200 bg-white text-[12.5px] text-slate-900 flex items-center w-full uppercase">USD</div>
          </div>
        </div>
        <div class="grid grid-cols-1 @sm:grid-cols-2 gap-2">
          <div>
            <span class="text-[10px] uppercase tracking-[0.14em] text-slate-400 font-medium block mb-1.5">Expected close</span>
            <div class="h-7 w-full px-2 rounded-md border border-slate-200 bg-white inline-flex items-center gap-1.5 text-[12px] transition-colors">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-slate-400 shrink-0" stroke-linecap="round" stroke-linejoin="round" set:html={ic.calendar}></svg>
              <span class="truncate flex-1 text-left text-slate-900">Jul 15, 2026</span>
              <span class="text-slate-400 shrink-0"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ic.x}></svg></span>
            </div>
          </div>
          <div>
            <span class="text-[10px] uppercase tracking-[0.14em] text-slate-400 font-medium block mb-1.5">Contact (read-only)</span>
            <div class="h-7 px-2.5 rounded-md border border-slate-200 bg-slate-50 text-[12.5px] text-slate-400 flex items-center w-full overflow-hidden whitespace-nowrap">rowan@stratech.io</div>
          </div>
        </div>
      </div>

      <div class="px-3 h-12 shrink-0 border-t border-slate-200 flex items-center gap-1.5">
        <span class="ml-auto h-7 px-2.5 rounded-md text-[12px] text-slate-700 inline-flex items-center">Cancel</span>
        <span class="h-7 px-3 rounded-md bg-slate-900 text-white text-[12px] font-medium inline-flex items-center gap-1.5">Save deal</span>
      </div>
    </div>
  </div>

  <DemoCursor />

  <!-- The dialog's own motion: scrim over 150ms, card 8px lift over 160ms. -->
  <style>
    .cd-react{opacity:0;pointer-events:none;transition:opacity .15s ease-out;}
    .cd-dialog{opacity:0;transform:translateY(8px);transition:opacity .16s ease-out,transform .16s ease-out;}
    .cd.is-open .cd-react{opacity:1;}
    .cd.is-open .cd-dialog{opacity:1;transform:none;}
    .cd.is-static .cd-react{display:none;}
  </style>
</div>

<script>
  import { playCursor } from '../lib/cursor';
  document.querySelectorAll<HTMLElement>('[data-demo="cd"]').forEach((root) => {
    playCursor(root, {
      loop: 11000,
      steps: [
        { at: 0, x: 50, y: 20 },
        { at: 2400, el: '[data-deal="stratech"]', ox: 0.5, oy: 0.5, hover: '[data-deal="stratech"]' },
        { at: 2540, press: true, target: '[data-deal="stratech"]', add: ['is-open'] },
        { at: 6200, el: '[data-cd="close"]', ox: 0.5, oy: 0.55, hover: '[data-cd="close"]' },
        { at: 6340, press: true, remove: ['is-open'] },
        { at: 9000, x: 50, y: 20 },
      ],
    });
  });
</script>
