---
/**
 * The /app/forms list, as web/src/app/app/forms/page.tsx draws it: topbar,
 * five-stat strip, the section bar with status tabs + category filter +
 * search, then the leads-style table with a trend sparkline per form.
 * Rendered inside AppShellMock by FeatureSection.
 */
import { nextId } from '../lib/uid';

type Status = 'published' | 'draft' | 'archived';
interface Row {
  name: string;
  status: Status;
  cats: { title: string; color: string }[];
  trend: number[];
  views: number;
  starts: number;
  subs: number;
  identified: number;
  created: string;
  last: string;
}

const cat = {
  inbound:    { title: 'Inbound',    color: '#0284c7' },
  enterprise: { title: 'Enterprise', color: '#7c3aed' },
  newsletter: { title: 'Newsletter', color: '#059669' },
  webinar:    { title: 'Webinar',    color: '#d97706' },
  partners:   { title: 'Partners',   color: '#db2777' },
};

// Sorted the way the page opens: newest created first.
const rows: Row[] = [
  { name: 'Pricing questions', status: 'published', cats: [cat.inbound],
    trend: [2, 5, 9, 14, 18, 24, 31, 27, 36, 41, 39, 44, 52, 58],
    views: 1120, starts: 481, subs: 119, identified: 97, created: '6d ago', last: '3h ago' },
  { name: 'Partner program', status: 'draft', cats: [cat.partners],
    trend: [], views: 0, starts: 0, subs: 0, identified: 0, created: '9d ago', last: 'never' },
  { name: 'Webinar: Cold email in 2026', status: 'published', cats: [cat.webinar, cat.inbound],
    trend: [4, 12, 19, 33, 28, 41, 56, 72, 64, 83, 91, 74, 68, 77],
    views: 1976, starts: 1103, subs: 356, identified: 302, created: '8/11/2026', last: '1h ago' },
  { name: 'Book a demo', status: 'published', cats: [cat.enterprise, cat.inbound],
    trend: [38, 42, 35, 51, 47, 63, 58, 71, 66, 74, 69, 82, 88, 94],
    views: 4812, starts: 2306, subs: 1041, identified: 388, created: '7/2/2026', last: '4m ago' },
  { name: 'Newsletter signup', status: 'published', cats: [cat.newsletter],
    trend: [22, 26, 24, 31, 29, 35, 33, 38, 41, 37, 44, 46, 43, 49],
    views: 3904, starts: 1822, subs: 762, identified: 141, created: '6/5/2026', last: '22m ago' },
  { name: 'Q1 campaign feedback', status: 'archived', cats: [cat.newsletter],
    trend: [14, 11, 9, 8, 6, 5, 4, 3, 2, 2, 1, 1, 0, 0],
    views: 668, starts: 220, subs: 40, identified: 40, created: '5/14/2026', last: '7/9/2026' },
];

const pill: Record<Status, string> = {
  draft: 'bg-slate-100 text-slate-600',
  published: 'bg-emerald-50 text-emerald-700',
  archived: 'bg-amber-50 text-amber-700',
};

const n = (v: number) => v.toLocaleString('en-US');
const conv = (r: Row) => (r.views <= 0 ? '–' : `${Math.min(100, (r.subs / r.views) * 100).toFixed(1)}%`);

const totals = {
  forms: rows.length,
  live: rows.filter((r) => r.status === 'published').length,
  views: rows.reduce((a, r) => a + r.views, 0),
  starts: rows.reduce((a, r) => a + r.starts, 0),
  subs: rows.reduce((a, r) => a + r.subs, 0),
};
const totalConv = `${Math.min(100, (totals.subs / totals.views) * 100).toFixed(1)}%`;
const counts = {
  all: rows.length,
  published: totals.live,
  draft: rows.filter((r) => r.status === 'draft').length,
  archived: rows.filter((r) => r.status === 'archived').length,
};

// Same maths as ui/charts Sparkline at 84x22: 2px pad, straight segments,
// area fill fading to nothing.
const SW = 84, SH = 22, PAD = 2;
function spark(values: number[]) {
  const max = Math.max(1, ...values);
  const w = SW - PAD * 2, h = SH - PAD * 2;
  const step = values.length > 1 ? w / (values.length - 1) : 0;
  const pts = values.map((v, i) => [PAD + i * step, PAD + h - (v / max) * h] as const);
  const line = pts.map(([x, y], i) => `${i === 0 ? 'M' : 'L'} ${x.toFixed(2)} ${y.toFixed(2)}`).join(' ');
  const area = `${line} L ${(PAD + (values.length - 1) * step).toFixed(2)} ${PAD + h} L ${PAD} ${PAD + h} Z`;
  return { line, area };
}
const sparkId = nextId('fspark');

const th = 'px-3 py-2 text-[10px] font-medium text-slate-400 uppercase tracking-[0.14em]';
const num = 'px-3 text-right font-mono text-[12px] tabular-nums whitespace-nowrap';
---
<div class="flex flex-col bg-white text-slate-900">
  <!-- PageTopbar -->
  <div class="min-h-12 @md:h-12 px-5 py-1.5 @md:py-0 border-b border-slate-200 flex flex-wrap @md:flex-nowrap items-center gap-3 gap-y-1.5 shrink-0 bg-white sticky top-0 z-10">
    <span class="text-[10px] uppercase tracking-[0.14em] text-slate-400 font-medium">Forms</span>
    <div class="h-4 w-px bg-slate-200"></div>
    <span class="text-[12.5px] text-slate-600 truncate">Hosted lead-capture forms you can embed anywhere</span>
    <div class="ml-auto flex items-center gap-1.5 min-w-0 flex-wrap justify-end @md:flex-nowrap">
      <button class="h-7 px-2.5 rounded-md inline-flex items-center gap-1.5 text-[12px] font-medium transition-colors bg-sky-600 text-white">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
        New form
      </button>
    </div>
  </div>

  <!-- StatStrip cols=5 -->
  <div class="grid border-b border-slate-200 shrink-0 bg-white grid-cols-2 @md:grid-cols-5">
    {[
      { label: 'Forms',       value: String(totals.forms),  sub: `${totals.live} live`,     accent: false, last: false },
      { label: 'Views',       value: n(totals.views),       sub: 'all time',                accent: false, last: false },
      { label: 'Starts',      value: n(totals.starts),      sub: 'began filling',           accent: false, last: false },
      { label: 'Submissions', value: n(totals.subs),        sub: 'all time',                accent: true,  last: false },
      { label: 'Conversion',  value: totalConv,             sub: 'submissions / views',     accent: false, last: true  },
    ].map((s) => (
      <div class={`group px-5 py-4 transition-colors min-w-0 ${!s.last ? 'border-r border-slate-200' : ''}`}>
        <div class="flex items-center gap-2">
          <span class="text-[10px] uppercase tracking-[0.14em] text-slate-400 font-medium">{s.label}</span>
          {s.accent && <span class="size-1.5 rounded-full bg-sky-500 animate-pulse"></span>}
        </div>
        <div class="text-[26px] text-slate-900 font-light leading-none mt-2 tabular-nums">{s.value}</div>
        <div class="text-[10px] text-slate-400 mt-1.5 font-mono truncate">{s.sub}</div>
      </div>
    ))}
  </div>

  <!-- SectionBar: status tabs, category filter, search -->
  <div class="min-h-9 @md:h-9 px-5 py-1.5 @md:py-0 border-b border-slate-200/60 flex flex-wrap @md:flex-nowrap items-center gap-x-2.5 gap-y-1.5 shrink-0">
    <span class="text-[10px] uppercase tracking-[0.14em] text-slate-400 font-medium">All forms</span>
    <span class="font-mono text-[10.5px] text-slate-400 tabular-nums">{rows.length}</span>
    <div class="ml-auto flex items-center gap-1.5 flex-wrap justify-end min-w-0"><div class="flex flex-wrap items-center gap-2">
      <div class="inline-flex items-center gap-0.5 rounded-md bg-slate-100 p-0.5">
        {[
          { label: 'All', count: counts.all, on: true },
          { label: 'Published', count: counts.published, on: false },
          { label: 'Drafts', count: counts.draft, on: false },
          { label: 'Archived', count: counts.archived, on: false },
        ].map((t) => (
          <span class={`h-6 px-2 rounded text-[11.5px] font-medium transition-colors inline-flex items-center ${t.on ? 'bg-white text-slate-900 shadow-sm' : 'text-slate-500'}`}>
            {t.label}<span class={`ml-1 tabular-nums ${t.on ? 'text-slate-400' : 'text-slate-400/80'}`}>{t.count}</span>
          </span>
        ))}
      </div>
      <div class="h-7 px-2.5 rounded-md border border-slate-200 bg-white text-[12px] text-slate-700 inline-flex items-center gap-1.5 transition-colors">
        <span class="truncate flex-1 text-left">All categories</span>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 shrink-0"><path d="m6 9 6 6 6-6"/></svg>
      </div>
      <div class="h-7 pl-2 pr-1 rounded-md border border-slate-200 bg-white flex items-center gap-1.5 min-w-0 w-56">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 shrink-0"><path d="m21 21-4.34-4.34"/><circle cx="11" cy="11" r="8"/></svg>
        <span class="flex-1 min-w-0 text-[12.5px] text-slate-400">Search forms&hellip;</span>
      </div>
    </div></div>
  </div>

  <!-- Table (PageBody) -->
  <div class="flex-1 min-h-0 overflow-hidden">
  <table class="w-full text-left">
    <thead class="sticky top-0 bg-white z-[1]">
      <tr class="border-b border-slate-200">
        <th class="pl-5 pr-2 py-2 w-9"><input type="checkbox" class="w-3.5 h-3.5 rounded accent-sky-600 align-middle" /></th>
        <th class={`${th} max-w-0 w-full @md:max-w-none @md:w-auto`}>Name</th>
        <th class={`${th} w-40 hidden @lg:table-cell`}>Categories</th>
        <th class={`${th} w-24 hidden @lg:table-cell`}>Trend</th>
        <th class={`${th} w-16 text-right`}>Views</th>
        <th class={`${th} w-16 text-right hidden @md:table-cell`}>Starts</th>
        <th class={`${th} w-16 text-right`}>Subs</th>
        <th class={`${th} w-16 text-right hidden @sm:table-cell`}>Conv</th>
        <th class={`${th} w-20 text-right hidden @md:table-cell`}>Identified</th>
        <th class={`${th} w-24 hidden @xl:table-cell`}>
          <span class="inline-flex items-center gap-0.5 uppercase tracking-[0.14em] transition-colors text-slate-700">Created
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </span>
        </th>
        <th class="w-12"></th>
      </tr>
    </thead>
    <tbody>
      {rows.map((r, i) => {
        const s = r.trend.some((v) => v > 0) ? spark(r.trend) : null;
        const gid = `${sparkId}-${i}`;
        return (
          <tr class="h-11 border-b border-slate-100 cursor-pointer transition-colors">
            <td class="pl-5 pr-2"><input type="checkbox" class="w-3.5 h-3.5 rounded accent-sky-600 align-middle" /></td>
            <td class="px-3 max-w-0 w-full @md:max-w-none @md:w-auto">
              <div class="flex items-center gap-2.5 min-w-0">
                <div class="w-6 h-6 rounded-md bg-slate-100 flex items-center justify-center shrink-0">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-500"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M12 11h4"/><path d="M12 16h4"/><path d="M8 11h.01"/><path d="M8 16h.01"/></svg>
                </div>
                <div class="min-w-0">
                  <div class="text-[12.5px] font-medium text-slate-900 truncate leading-tight flex items-center gap-1.5">
                    <span class="truncate">{r.name}</span>
                    <span class={`inline-flex items-center h-4 px-1.5 rounded text-[10px] font-medium shrink-0 ${pill[r.status]}`}>{r.status}</span>
                  </div>
                  <div class="text-[11px] text-slate-500 truncate">Last submission {r.last}</div>
                </div>
              </div>
            </td>
            <td class="px-3 hidden @lg:table-cell">
              <div class="flex items-center gap-1 min-w-0">
                {r.cats.map((c) => (
                  <span class="inline-flex items-center gap-1 h-[18px] px-1.5 rounded bg-slate-50 border border-slate-200 text-[10.5px] text-slate-600 min-w-0">
                    <span class="w-1.5 h-1.5 rounded-full shrink-0" style={`background-color:${c.color}`}></span>
                    <span class="truncate max-w-20">{c.title}</span>
                  </span>
                ))}
              </div>
            </td>
            <td class="px-3 hidden @lg:table-cell">
              {s ? (
                <svg width={SW} height={SH} viewBox={`0 0 ${SW} ${SH}`} class="block">
                  <defs>
                    <linearGradient id={gid} x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="#0284c7" stop-opacity="0.18" />
                      <stop offset="100%" stop-color="#0284c7" stop-opacity="0" />
                    </linearGradient>
                  </defs>
                  <path d={s.area} fill={`url(#${gid})`} />
                  <path d={s.line} fill="none" stroke="#0284c7" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round" />
                </svg>
              ) : (
                <span class="text-[11px] text-slate-300">–</span>
              )}
            </td>
            <td class={`${num} text-slate-500`}>{n(r.views)}</td>
            <td class={`${num} text-slate-500 hidden @md:table-cell`}>{n(r.starts)}</td>
            <td class={`${num} text-slate-900`}>{n(r.subs)}</td>
            <td class={`${num} text-slate-500 hidden @sm:table-cell`}>{conv(r)}</td>
            <td class={`${num} text-slate-500 hidden @md:table-cell`}>{n(r.identified)}</td>
            <td class="px-3 text-[12px] text-slate-500 whitespace-nowrap hidden @xl:table-cell">{r.created}</td>
            <td class="pr-3">
              <span class="size-7 rounded-md text-slate-400 inline-flex items-center justify-center transition-colors">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg>
              </span>
            </td>
          </tr>
        );
      })}
    </tbody>
  </table>
  </div>
</div>
