---
/**
 * The "Book a demo" form as the hosted renderer draws a split layout
 * (forms/src/FormPage.tsx + FormRenderer.tsx + form-theme.css, design
 * defaults from designCore.ts): the cover column with the logo, title and
 * subtitle over the cover image and its accent wash, then `.wf-main` with
 * the field grid, the submit row and the "Powered by Warmbly" line.
 *
 * The same component sits on the builder canvas, where `selected` marks a
 * field the way SortableField does: the sky ring and the drag / duplicate /
 * delete toolbar.
 */
interface Props { selected?: string }
const { selected } = Astro.props;

type Field =
  | { id: string; kind: 'heading'; text: string }
  | { id: string; kind: 'paragraph'; text: string }
  | { id: string; kind: 'input'; label: string; placeholder: string; half?: boolean; required?: boolean; value?: string; focus?: boolean }
  | { id: string; kind: 'select'; label: string; value: string; half?: boolean }
  | { id: string; kind: 'textarea'; label: string; placeholder: string; help?: string }
  | { id: string; kind: 'checkbox'; text: string };

const fields: Field[] = [
  { id: 'h', kind: 'heading', text: 'Tell us about your outreach' },
  { id: 'p', kind: 'paragraph', text: 'We reply within one business day.' },
  { id: 'fn', kind: 'input', label: 'First name', placeholder: 'Maya', half: true, required: true, value: 'Maya' },
  { id: 'ln', kind: 'input', label: 'Last name', placeholder: 'Okonkwo', half: true, required: true, value: 'Okonkwo' },
  { id: 'em', kind: 'input', label: 'Work email', placeholder: 'you@company.com', required: true, value: 'maya@northwind.dev', focus: true },
  { id: 'co', kind: 'input', label: 'Company', placeholder: 'Northwind', half: true, value: 'Northwind' },
  { id: 'sz', kind: 'select', label: 'Team size', value: '11 to 50', half: true },
  { id: 'msg', kind: 'textarea', label: 'What are you hoping to solve?', placeholder: 'Deliverability, volume, replies, CRM handoff...', help: 'Optional, but it makes the call better.' },
  { id: 'ok', kind: 'checkbox', text: 'Send me the occasional deliverability note. Unsubscribe any time.' },
];

// FONT_CATALOG.inter.stack and the resolveDesign defaults.
const font = "font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;";
const ACCENT = '#0284c7';
// The owner's cover image (a photo in the app) under the accent wash.
const coverImage = 'linear-gradient(160deg, #0b2a4a 0%, #0f3d6e 55%, #0c2f57 100%)';

const inputStyle = `width:100%; font-size:14px; color:#0f172a; background:#fff; border:1px solid #e2e8f0; border-radius:10px; padding:10px 12px; ${font}`;
const focusStyle = `border-color:${ACCENT}; box-shadow:0 0 0 3px color-mix(in srgb, ${ACCENT} 18%, transparent);`;
---
<div class="wfm w-full min-h-full grid" style={`${font} grid-template-columns: minmax(260px, 38%) 1fr; background:#f8fafc;`}>
  <!-- .wf-cover: the image, the accent wash, logo / title / subtitle -->
  <aside class="relative overflow-hidden" style={`padding:40px 36px; background:${coverImage};`}>
    <div class="absolute inset-0 pointer-events-none" style={`background: linear-gradient(150deg, color-mix(in srgb, ${ACCENT} 30%, transparent), transparent 68%);`}></div>
    <div class="relative">
      <!-- .wf-logo: the owner's logo image, 36px tall -->
      <svg viewBox="0 0 160 36" style="display:block; height:36px; max-width:60%; margin:0 0 20px;" aria-label="Northwind">
        <rect x="0" y="0" width="36" height="36" rx="9" fill="#ffffff"/>
        <text x="18" y="24" text-anchor="middle" font-size="16" font-weight="700" fill="#0f172a" font-family="Inter, system-ui, sans-serif">N</text>
        <text x="46" y="24" font-size="17" font-weight="600" fill="#ffffff" letter-spacing="-0.2" font-family="Inter, system-ui, sans-serif">Northwind</text>
      </svg>
      <p style="margin:16px 0 0; font-size:24px; font-weight:600; line-height:1.2; letter-spacing:-0.02em; color:#fff; text-shadow:0 1px 12px rgba(15,23,42,.35);">See it on your own mailboxes.</p>
      <p style="margin:8px 0 0; font-size:14px; line-height:1.55; color:rgba(255,255,255,.86); text-shadow:0 1px 10px rgba(15,23,42,.3); white-space:pre-line;">Thirty minutes with someone who runs outreach at Northwind. Bring a domain and we will show you what a safe ramp looks like.</p>
    </div>
  </aside>

  <!-- .wf-main (split): centred column, 64px vertical padding, 560px measure -->
  <main class="flex flex-col justify-center bg-white" style="padding:64px max(48px, calc((100% - 560px) / 2));">
    <div class="flex flex-wrap" style="gap:16px;">
      {fields.map((f) => {
        const half = 'half' in f && f.half;
        const isSel = selected === f.id;
        return (
          <div class={`relative min-w-0 ${isSel ? 'rounded-md ring-2 ring-sky-400 ring-offset-2' : ''}`} style={half ? 'flex: 1 1 calc(50% - 16px);' : 'flex: 1 1 100%;'}>
            {isSel && (
              <div class="absolute -top-2.5 right-1 z-10 flex items-center gap-0.5 rounded-md border border-slate-200 bg-white shadow-sm px-0.5">
                <span class="size-5 inline-flex items-center justify-center text-slate-400"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="12" r="1"/><circle cx="9" cy="5" r="1"/><circle cx="9" cy="19" r="1"/><circle cx="15" cy="12" r="1"/><circle cx="15" cy="5" r="1"/><circle cx="15" cy="19" r="1"/></svg></span>
                <span class="size-5 inline-flex items-center justify-center text-slate-400"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg></span>
                <span class="size-5 inline-flex items-center justify-center text-slate-400"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></svg></span>
              </div>
            )}
            {f.kind === 'heading' && <p style="margin:2px 0 0; font-size:22px; font-weight:600; line-height:1.25; letter-spacing:-0.015em; color:#0f172a;">{f.text}</p>}
            {f.kind === 'paragraph' && <p style="margin:0; font-size:14px; line-height:1.55; color:#0f172a; opacity:.85;">{f.text}</p>}
            {f.kind === 'input' && (
              <div>
                <label style="display:block; font-size:13px; font-weight:500; color:#334155; margin:0 0 6px;">{f.label}{f.required && <span style="color:#dc2626;"> *</span>}</label>
                <div style={`${inputStyle} ${f.focus ? focusStyle : ''}`}>{f.value ? f.value : <span style="color:#94a3b8;">{f.placeholder}</span>}</div>
              </div>
            )}
            {f.kind === 'select' && (
              <div>
                <label style="display:block; font-size:13px; font-weight:500; color:#334155; margin:0 0 6px;">{f.label}</label>
                <div class="flex items-center justify-between" style={inputStyle}>
                  <span>{f.value}</span>
                  <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M1 3l4 4 4-4" fill="none" stroke="#475569" stroke-width="1.5"/></svg>
                </div>
              </div>
            )}
            {f.kind === 'textarea' && (
              <div>
                <label style="display:block; font-size:13px; font-weight:500; color:#334155; margin:0 0 6px;">{f.label}</label>
                <div style={`${inputStyle} min-height:104px; resize:vertical;`}><span style="color:#94a3b8;">{f.placeholder}</span></div>
                {f.help && <div style="font-size:12px; color:#94a3b8; margin:5px 0 0;">{f.help}</div>}
              </div>
            )}
            {f.kind === 'checkbox' && (
              <label class="flex items-center" style="gap:8px; font-size:14px; color:#0f172a; cursor:pointer;">
                <span class="shrink-0" style="width:15px; height:15px; border:1px solid #767676; border-radius:3px; background:#fff;"></span>
                {f.text}
              </label>
            )}
          </div>
        );
      })}
      <!-- .btnrow -->
      <div class="flex" style="flex: 1 1 100%; margin-top:4px; width:100%;">
        <span style={`font-weight:600; font-size:14px; color:#fff; background:${ACCENT}; border-radius:10px; padding:10px 20px; display:inline-flex; align-items:center;`}>Book my demo</span>
      </div>
    </div>
    <!-- .brand -->
    <div style="text-align:center; margin-top:14px; padding-bottom:8px;"><span style="font-size:11px; color:#94a3b8;">Powered by Warmbly</span></div>
  </main>
</div>
