---
import DemoCursor from './DemoCursor.astro';
/**
 * The /app/api-keys screen, mirrored from the app:
 *
 *   - web/src/app/app/api-keys/page.tsx                       PageTopbar / StatStrip / Traffic (StackedBars) /
 *                                                             Quick start (CodeSnippet) / Keys (KeyRow, StatusPill)
 *   - web/src/app/app/api-keys/_components/CreateKeyModal.tsx the Create API key modal (the reaction): Name,
 *                                                             Description, Permissions (presets + matrix),
 *                                                             Rate limit, Expires, the IP allowlist disclosure
 *   - web/src/components/layout/Page.tsx                      PageTopbar / StatStrip / Stat / SectionBar / TopbarAction
 *   - internal/models/api_permission.go                      the real scope names + descriptions + categories
 *
 * Demo: the cursor presses Create key, the modal opens, then a click on the
 * scrim dismisses it.
 */

const keys = [
  { name: 'production-server', desc: 'Server-side calls from EU production', prefix: 'wmbly_live_a1', suffix: '4f2a', rpm: 600, last: 'used 2m ago', status: 'active' as const },
  { name: 'ci-pipeline', desc: 'GitHub Actions deploy step', prefix: 'wmbly_live_7c', suffix: '91c7', rpm: 120, last: 'used 1h ago', status: 'active' as const },
  { name: 'zapier-replies', desc: 'Inbound reply automation', prefix: 'wmbly_live_3d', suffix: '3d8e', rpm: 300, last: 'never used', status: 'active' as const },
  { name: 'old-laptop', desc: 'Rotated out, kept for audit', prefix: 'wmbly_live_0p', suffix: 'xx0p', rpm: 120, last: 'used 23d ago', status: 'revoked' as const },
];

const statusTone = (s: string) =>
  s === 'active'
    ? { bg: 'bg-emerald-50', text: 'text-emerald-700', dot: 'bg-emerald-500' }
    : s === 'revoked'
      ? { bg: 'bg-rose-50', text: 'text-rose-700', dot: 'bg-rose-500' }
      : { bg: 'bg-slate-100', text: 'text-slate-600', dot: 'bg-slate-400' };

const stats = [
  { label: 'Active keys', value: '3', sub: '1 inactive', accent: true, last: false },
  { label: 'Requests · 24h', value: '8,241', sub: '4 errors', accent: false, last: false },
  { label: 'Avg latency · 24h', value: '28ms', sub: 'across all keys', accent: false, last: false },
  { label: 'Last call', value: '14s ago', sub: 'Jun 6, 02:02 PM', accent: false, last: true },
];

// 24 hourly buckets: 2xx / 4xx / 5xx shares of a 104px-tall bar.
const buckets = [42, 55, 38, 61, 49, 72, 58, 80, 64, 47, 69, 53, 76, 60, 84, 51, 68, 57, 73, 45, 62, 79, 54, 66];

const keyIcon = '<path d="m15.5 7.5 2.3 2.3a1 1 0 0 0 1.4 0l2.1-2.1a1 1 0 0 0 0-1.4L19 4"/><path d="m21 2-9.6 9.6"/><circle cx="7.5" cy="15.5" r="5.5"/>';
const gaugeIcon = '<path d="m12 14 4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/>';

// PermissionMatrix groups, in api_permission.go order.
const perms = [
  { group: 'read', rows: [
    ['READ_EMAILS', 'View email accounts and settings'],
    ['READ_CAMPAIGNS', 'View campaigns and sequences'],
    ['READ_CONTACTS', 'View contact lists, segments, notes, and activities'],
    ['READ_UNIBOX', 'View emails in the unified inbox'],
    ['READ_ANALYTICS', 'View analytics and reports'],
  ], on: true },
  { group: 'write', rows: [
    ['WRITE_EMAILS', 'Modify email account settings'],
    ['WRITE_CAMPAIGNS', 'Create and modify campaigns and sequences'],
    ['WRITE_CONTACTS', 'Create and modify contacts, segments, notes, and activities'],
  ], on: false },
];
---
<div class="dv relative w-full bg-white flex flex-col" style="min-height:520px;" data-demo="dv">

  <!-- PageTopbar -->
  <div class="min-h-12 md:h-12 px-5 py-1.5 md:py-0 border-b border-slate-200 flex flex-wrap md:flex-nowrap items-center gap-3 gap-y-1.5 shrink-0 bg-white sticky top-0 z-10">
    <span class="text-[10px] uppercase tracking-[0.14em] text-slate-400 font-medium">API keys</span>
    <div class="h-4 w-px bg-slate-200"></div>
    <span class="text-[12.5px] text-slate-600 truncate">Programmatic access · stripe-style scoped tokens</span>
    <div class="ml-auto flex items-center gap-1.5 min-w-0 flex-wrap justify-end md:flex-nowrap">
      <!-- SearchPill -->
      <div class="h-7 px-2 rounded-md border border-slate-200 bg-white flex items-center gap-1.5 transition-colors">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-slate-400" stroke-linecap="round" stroke-linejoin="round"><path d="m21 21-4.34-4.34"/><circle cx="11" cy="11" r="8"/></svg>
        <span class="w-[100px] sm:w-[140px] h-5 inline-flex items-center text-[12px] text-slate-400">Search…</span>
      </div>
      <!-- Refresh -->
      <span class="h-7 w-7 rounded-md border border-slate-200 text-slate-500 inline-flex items-center justify-center transition-colors">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/></svg>
      </span>
      <!-- Create key (TopbarAction) -->
      <button id="dv-create" class="h-7 px-2.5 rounded-md inline-flex items-center gap-1.5 text-[12px] font-medium transition-colors bg-sky-600 text-white [&.is-hover]:bg-sky-700 [&.is-pressed]:bg-sky-700">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
        <span class="hidden sm:inline">Create key</span>
      </button>
    </div>
  </div>

  <!-- StatStrip -->
  <div class="grid border-b border-slate-200 shrink-0 bg-white grid-cols-2 md:grid-cols-4">
    {stats.map((s) => (
      <div class={`group px-5 py-4 transition-colors ${!s.last ? 'border-r border-slate-200' : ''}`}>
        <div class="flex items-center gap-2">
          <span class="text-[10px] uppercase tracking-[0.14em] text-slate-400 font-medium">{s.label}</span>
          {s.accent && <span class="size-1.5 rounded-full bg-sky-500 animate-pulse"></span>}
        </div>
        <div class="text-[26px] text-slate-900 font-light leading-none mt-2 tabular-nums">{s.value}</div>
        <div class="text-[10px] text-slate-400 mt-1.5 font-mono truncate">{s.sub}</div>
      </div>
    ))}
  </div>

  <!-- SectionBar · Traffic last 24h -->
  <div class="min-h-9 md:h-9 px-5 py-1.5 md:py-0 border-b border-slate-200/60 flex flex-wrap md:flex-nowrap items-center gap-x-2.5 gap-y-1.5 shrink-0">
    <span class="text-[10px] uppercase tracking-[0.14em] text-slate-400 font-medium">Traffic · last 24h</span>
    <span class="font-mono text-[10.5px] text-slate-400 tabular-nums">8,241</span>
  </div>

  <!-- StackedBars: 120px tall, a 104px DitherColumns canvas, baseline and ticks -->
  <div class="px-5 py-4 border-b border-slate-200/60">
    <div class="relative w-full" style="height:120px;">
      <div class="flex items-end gap-[2px]" style="height:104px;">
        {buckets.map((h, i) => (
          <div class="flex-1 flex flex-col justify-end" style="height:104px;">
            {i % 7 === 3 && <div class="w-full dv-dither" style="height:4px; --c:244,63,94;"></div>}
            {i % 5 === 2 && <div class="w-full dv-dither" style="height:6px; --c:245,158,11;"></div>}
            <div class="w-full dv-dither" style={`height:${h}%; --c:16,185,129;`}></div>
          </div>
        ))}
      </div>
      <div class="absolute left-0 right-0 bottom-3 h-px bg-slate-200/80"></div>
      <div class="absolute left-0 right-0 bottom-0 flex justify-between font-mono text-[9.5px] text-slate-400">
        <span>Jun 5, 03:00 PM</span>
        <span>Jun 6, 02:00 PM</span>
      </div>
    </div>
    <div class="mt-2 flex items-center gap-3 text-[10.5px] text-slate-500">
      <span class="inline-flex items-center gap-1"><span class="size-1.5 rounded-sm bg-emerald-500/80"></span>2xx</span>
      <span class="inline-flex items-center gap-1"><span class="size-1.5 rounded-sm bg-amber-400/80"></span>4xx</span>
      <span class="inline-flex items-center gap-1"><span class="size-1.5 rounded-sm bg-rose-500/80"></span>5xx</span>
      <span class="ml-auto inline-flex items-center gap-1.5 text-[10.5px] text-slate-400">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={gaugeIcon}></svg>
        live; refreshes every minute
      </span>
    </div>
  </div>

  <!-- SectionBar · Quick start + CodeSnippet -->
  <div class="min-h-9 md:h-9 px-5 py-1.5 md:py-0 border-b border-slate-200/60 flex flex-wrap md:flex-nowrap items-center gap-x-2.5 gap-y-1.5 shrink-0">
    <span class="text-[10px] uppercase tracking-[0.14em] text-slate-400 font-medium">Quick start</span>
  </div>
  <div class="px-5 py-4 border-b border-slate-200/60">
    <div class="rounded-md border border-slate-200 bg-slate-950 overflow-hidden">
      <div class="h-8 px-3 flex items-center gap-2 border-b border-slate-800/60">
        <span class="size-1.5 rounded-full bg-red-400/70"></span>
        <span class="size-1.5 rounded-full bg-amber-400/70"></span>
        <span class="size-1.5 rounded-full bg-emerald-400/70"></span>
        <span class="ml-2 text-[11px] text-slate-400 font-mono">curl</span>
        <span class="ml-auto inline-flex items-center gap-1 h-6 px-2 rounded text-slate-400 text-[11px] transition-colors">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
          Copy
        </span>
      </div>
      <pre class="px-4 py-3 text-[12px] leading-relaxed text-slate-200 font-mono whitespace-pre overflow-x-auto">curl https://api.warmbly.com/v1/campaigns \
  -H "Authorization: Bearer wmbly_live_a1……" \
  -H "Content-Type: application/json"</pre>
    </div>
    <p class="text-[11.5px] text-slate-500 mt-2 leading-relaxed">
      Pass the secret as a <span class="font-mono">Bearer</span> header. Every request returns
      rate-limit headers (<span class="font-mono">X-RateLimit-Limit</span>,
      <span class="font-mono">X-RateLimit-Remaining</span>) so well-behaved clients can self-throttle
      before hitting <span class="font-mono">429</span>.
    </p>
  </div>

  <!-- SectionBar · Keys -->
  <div class="min-h-9 md:h-9 px-5 py-1.5 md:py-0 border-b border-slate-200/60 flex flex-wrap md:flex-nowrap items-center gap-x-2.5 gap-y-1.5 shrink-0">
    <span class="text-[10px] uppercase tracking-[0.14em] text-slate-400 font-medium">Keys</span>
    <span class="font-mono text-[10.5px] text-slate-400 tabular-nums">4</span>
  </div>

  <!-- Keys list (PageBody > KeyRow, divide-y) -->
  <div class="flex-1 min-h-0 overflow-hidden">
    <div class="divide-y divide-slate-200/60">
      {keys.map((k) => {
        const t = statusTone(k.status);
        return (
          <div class="w-full h-12 px-5 flex items-center gap-3 text-left transition-colors group">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class={`shrink-0 ${k.status === 'active' ? 'text-slate-500' : 'text-slate-300'}`} stroke-linecap="round" stroke-linejoin="round" set:html={keyIcon}></svg>
            <div class="flex flex-col min-w-0 max-w-[40%]">
              <span class="text-[12.5px] text-slate-900 font-medium truncate">{k.name}</span>
              <span class="text-[10.5px] text-slate-500 truncate">{k.desc}</span>
            </div>
            <span class="font-mono text-[10.5px] text-slate-500 truncate">{k.prefix}…{k.suffix}</span>
            <span class={`inline-flex items-center gap-1 h-5 px-1.5 rounded text-[10px] uppercase tracking-[0.08em] font-medium ${t.bg} ${t.text}`}>
              <span class={`size-1.5 rounded-full ${t.dot}`}></span>
              {k.status}
            </span>
            <span class="ml-auto flex items-center gap-3 shrink-0">
              <span class="hidden sm:inline text-[10.5px] text-slate-400 tabular-nums">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="inline mr-1 align-[-2px]" stroke-linecap="round" stroke-linejoin="round" set:html={gaugeIcon}></svg>{k.rpm}/m
              </span>
              <span class="hidden md:inline font-mono text-[10.5px] text-slate-400 tabular-nums w-32 text-right truncate">{k.last}</span>
            </span>
          </div>
        );
      })}
    </div>
  </div>

  <!-- CreateKeyModal: portaled to the body in the app, fixed over the whole window. -->
  <div class="dv-react fixed inset-0 z-40" aria-hidden="true">
    <div class="absolute inset-0 bg-black/40"></div>
    <div class="dv-card absolute left-1/2 -translate-x-1/2 z-50 w-[560px] max-w-[92vw] bg-white rounded-lg border border-slate-200 shadow-[0_24px_60px_-12px_rgba(15,23,42,0.25)] overflow-hidden" style="top:10%;">

      <!-- ConfigureStep header -->
      <div class="h-11 px-4 border-b border-slate-200 flex items-center gap-2">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-slate-500" stroke-linecap="round" stroke-linejoin="round" set:html={keyIcon}></svg>
        <span class="text-[12.5px] font-medium text-slate-900">Create API key</span>
        <span class="ml-auto w-7 h-7 rounded-md inline-flex items-center justify-center text-slate-500">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </span>
      </div>

      <div class="px-5 py-4 space-y-4 max-h-[70dvh] overflow-hidden">
        <!-- Name (autofocused, empty) -->
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="text-[11px] uppercase tracking-[0.14em] text-slate-500 font-medium">Name</span>
          </div>
          <div class="w-full h-8 px-2.5 rounded-md border border-sky-400 ring-1 ring-sky-200 bg-white flex items-center">
            <span class="dv-caret w-px h-3.5 bg-slate-900"></span>
            <span class="text-[12.5px] text-slate-400">production-server</span>
          </div>
          <p class="text-[10.5px] text-slate-400 mt-1 leading-relaxed">Shown in the dashboard. e.g. production-server, ci-pipeline.</p>
        </div>

        <!-- Description -->
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="text-[11px] uppercase tracking-[0.14em] text-slate-500 font-medium">Description</span>
            <span class="text-[10px] text-slate-400 font-mono">optional</span>
          </div>
          <div class="w-full h-[50px] px-2.5 py-1.5 rounded-md border border-slate-200 bg-white text-[12.5px] text-slate-400 resize-none">Server-side calls from EU production</div>
          <p class="text-[10.5px] text-slate-400 mt-1 leading-relaxed">Internal note. Where will this key be used?</p>
        </div>

        <!-- Permissions: presets + matrix -->
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="text-[11px] uppercase tracking-[0.14em] text-slate-500 font-medium">Permissions</span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-1.5 mb-2">
            <div class="relative text-left rounded-md border px-2.5 py-2 transition-colors border-sky-400 bg-sky-50/60">
              <div class="flex items-center gap-1.5 mb-0.5">
                <span class="text-sky-600"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></svg></span>
                <span class="text-[11.5px] font-medium text-sky-900">Read-only</span>
              </div>
              <p class="text-[10.5px] text-slate-500">View everything</p>
            </div>
            <div class="relative text-left rounded-md border px-2.5 py-2 transition-colors border-slate-200 bg-white">
              <div class="flex items-center gap-1.5 mb-0.5">
                <span class="text-slate-500"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg></span>
                <span class="text-[11.5px] font-medium text-slate-900">Full access</span>
              </div>
              <p class="text-[10.5px] text-slate-500">Read + write</p>
            </div>
            <div class="relative text-left rounded-md border px-2.5 py-2 transition-colors border-slate-200 bg-white">
              <div class="flex items-center gap-1.5 mb-0.5">
                <span class="text-slate-500"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="4" y1="21" y2="14"/><line x1="4" x2="4" y1="10" y2="3"/><line x1="12" x2="12" y1="21" y2="12"/><line x1="12" x2="12" y1="8" y2="3"/><line x1="20" x2="20" y1="21" y2="16"/><line x1="20" x2="20" y1="12" y2="3"/><line x1="1" x2="7" y1="14" y2="14"/><line x1="9" x2="15" y1="8" y2="8"/><line x1="17" x2="23" y1="16" y2="16"/></svg></span>
                <span class="text-[11.5px] font-medium text-slate-900">Custom</span>
              </div>
              <p class="text-[10.5px] text-slate-500">Pick scopes</p>
            </div>
          </div>
          <!-- PermissionMatrix: 224px, scrolls -->
          <div class="rounded-md border border-slate-200 divide-y divide-slate-200/60 max-h-56 overflow-hidden">
            {perms.map((g) => (
              <div>
                <div class="px-2.5 py-1.5 bg-slate-50/60 text-[10px] uppercase tracking-[0.14em] text-slate-500 font-medium">{g.group}</div>
                <div>
                  {g.rows.map(([name, desc]) => (
                    <div class="w-full px-2.5 py-1.5 flex items-center gap-2 text-left transition-colors">
                      {g.on
                        ? <span class="w-3.5 h-3.5 rounded border border-sky-600 bg-sky-600 text-white flex items-center justify-center shrink-0 transition-colors"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
                        : <span class="w-3.5 h-3.5 rounded border border-slate-300 bg-white shrink-0 transition-colors"></span>}
                      <span class="font-mono text-[11px] text-slate-900">{name}</span>
                      <span class="text-[10.5px] text-slate-500 truncate">{desc}</span>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Rate limit (RateLimitSetter) -->
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="text-[11px] uppercase tracking-[0.14em] text-slate-500 font-medium">Rate limit</span>
          </div>
          <div class="rounded-lg border border-slate-200 bg-white px-3 py-3">
            <div class="flex items-center justify-center gap-3">
              <span class="w-8 h-8 rounded-md border border-slate-200 text-slate-500 inline-flex items-center justify-center transition-colors"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/></svg></span>
              <span class="w-[74px] text-center text-[22px] font-semibold tabular-nums text-slate-900">60</span>
              <span class="text-[11px] text-slate-400 whitespace-nowrap">req / min</span>
              <span class="w-8 h-8 rounded-md border border-slate-200 text-slate-500 inline-flex items-center justify-center transition-colors"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg></span>
            </div>
            <div class="w-full mt-3 h-1.5 rounded-full bg-slate-200 relative"><div class="absolute left-0 top-0 h-full w-[6%] rounded-full bg-sky-600"></div><span class="absolute top-1/2 -translate-y-1/2 size-3.5 rounded-full bg-sky-600 border border-white shadow" style="left:6%;"></span></div>
            <div class="flex items-center justify-center gap-1.5 mt-2.5">
              {['30', '60', '120', '600', '1k'].map((v) => (
                <span class={`h-6 px-2.5 rounded-md text-[11px] tabular-nums transition-colors inline-flex items-center ${v === '60' ? 'bg-sky-600 text-white' : 'border border-slate-200 text-slate-600'}`}>{v}</span>
              ))}
            </div>
          </div>
          <p class="text-[10.5px] text-slate-400 mt-1 leading-relaxed">Soft cap, sliding window. We return 429 + Retry-After when exceeded.</p>
        </div>

        <!-- Expires -->
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="text-[11px] uppercase tracking-[0.14em] text-slate-500 font-medium">Expires</span>
          </div>
          <div class="flex items-center gap-1">
            <span class="h-7 px-3 rounded-md text-[11.5px] transition-colors bg-slate-900 text-white inline-flex items-center">Never</span>
            <span class="h-7 px-3 rounded-md text-[11.5px] transition-colors border border-slate-200 text-slate-600 inline-flex items-center">30 days</span>
            <span class="h-7 px-3 rounded-md text-[11.5px] transition-colors border border-slate-200 text-slate-600 inline-flex items-center">90 days</span>
            <span class="h-7 px-3 rounded-md text-[11.5px] transition-colors border border-slate-200 text-slate-600 inline-flex items-center">365 days</span>
          </div>
        </div>

        <span class="text-[11.5px] text-slate-500 underline-offset-2">Advanced (IP allowlist)</span>
      </div>

      <!-- footer -->
      <div class="h-12 px-4 border-t border-slate-200 flex items-center gap-2 bg-slate-50/40">
        <span class="hidden md:inline-flex text-[11px] text-slate-500 items-center gap-1.5">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          The secret will be shown once. Save it somewhere safe.
        </span>
        <div class="ml-auto flex items-center gap-1.5">
          <span class="h-7 px-3 rounded-md border border-slate-200 text-[12px] text-slate-700 inline-flex items-center transition-colors">Cancel</span>
          <span class="h-7 px-3 rounded-md bg-sky-600 text-white text-[12px] font-medium inline-flex items-center gap-1.5 transition-colors">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={keyIcon}></svg>
            Create key
          </span>
        </div>
      </div>
    </div>
  </div>

  <DemoCursor />

  <!-- Scene styles: CreateKeyModal's own enter and exit (scrim 150ms, card
       8px lift + 0.99 scale over 180ms), driven by .is-open. The traffic
       bars carry the DitherColumns halftone (8x8 Bayer at 0.85). -->
  <style>
    .dv-react{opacity:0;pointer-events:none;transition:opacity .15s ease-out;}
    .dv-card{opacity:0;transform:translate(-50%, 8px) scale(.99);transition:opacity .18s ease-out,transform .18s ease-out;}
    .dv.is-open .dv-react{opacity:1;}
    .dv.is-open .dv-card{opacity:1;transform:translate(-50%, 0) scale(1);}
    .dv-caret{display:inline-block;animation:dv-blink 1s step-end infinite;}
    @keyframes dv-blink{0%,49%{opacity:1}50%,100%{opacity:0}}
    .dv-dither{background-color:rgb(var(--c) / .84);background-image:repeating-conic-gradient(rgb(var(--c) / .3) 0 25%, transparent 0 50%);background-size:2px 2px;}
    .dv.is-static .dv-react{display:none;}
  </style>
</div>

<script>
  import { playCursor } from '../lib/cursor';
  document.querySelectorAll<HTMLElement>('[data-demo="dv"]').forEach((root) => {
    playCursor(root, {
      loop: 11000,
      steps: [
        { at: 0, x: 30, y: 60 },
        { at: 2400, el: '#dv-create', ox: 0.55, oy: 0.55, hover: '#dv-create' },
        { at: 2540, press: true, target: '#dv-create', add: ['is-open'] },
        { at: 5800, x: 8, y: 85 },
        { at: 5940, press: true, remove: ['is-open'] },
        { at: 8600, x: 30, y: 60 },
      ],
    });
  });
</script>
