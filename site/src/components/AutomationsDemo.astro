---
/**
 * Live demo of the Warmbly automation builder (/app/automations/:id),
 * mirrored from web/src/components/app/automations/AutomationFlow.tsx:
 *
 *   - the builder header: back, the name input, the Active switch, then
 *     History / Test / Tidy up / Saved
 *   - the React Flow canvas: dots at 24px, the top-left Add action split
 *     button and Add condition, the bottom-center hint, TriggerNode /
 *     ConditionNode / ActionNode
 *   - the Test run side panel (InsightsPanel in a SidePanel): the dry-run
 *     intro, the editable sample event, the steps to run, the Run test
 *     button, then one NodeResultRow per node the run touched
 *
 * Drawn inside the full app shell so it is the whole dashboard on screen.
 * The builder keeps its 1280px design width, which with the 256px sidebar
 * makes a 1536px window, uniformly scaled to fit.
 *
 * Demo: the cursor presses Test, the panel springs in from the right, Run
 * test runs the dry run, the trace lands, then the panel is closed again.
 * Clicking the real Test button restarts the loop.
 */
import AppShellMock from './AppShellMock.astro';
import DemoCursor from './DemoCursor.astro';
import { RAW_BRAND_LOGOS } from '../lib/brandLogos';
import { BRAND_ICON } from '../lib/brandIcons';

const zapIcon = '<path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/>';
const gitBranchIcon = '<line x1="6" x2="6" y1="3" y2="15"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M18 9a9 9 0 0 1-9 9"/>';
const briefcaseIcon = '<path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/><rect width="20" height="14" x="2" y="6" rx="2"/>';
const tagIcon = '<path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"/><circle cx="7.5" cy="7.5" r=".5" fill="currentColor"/>';
const sendIcon = '<path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.5.5 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"/><path d="m21.854 2.147-10.94 10.939"/>';
const historyIcon = '<path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l4 2"/>';
const playIcon = '<path d="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-11.997 7A2 2 0 0 1 5 19z"/>';
const checkIcon = '<path d="M20 6 9 17l-5-5"/>';
const checkCircleIcon = '<path d="M21.801 10A10 10 0 1 1 17 3.335"/><path d="m9 11 3 3L22 4"/>';
const arrowLeftIcon = '<path d="m12 19-7-7 7-7"/><path d="M19 12H5"/>';
const plusIcon = '<path d="M5 12h14"/><path d="M12 5v14"/>';
const xIcon = '<path d="M18 6 6 18"/><path d="m6 6 12 12"/>';
const trashIcon = '<path d="M10 11v6"/><path d="M14 11v6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>';
const chevronIcon = '<path d="m6 9 6 6 6-6"/>';
const loaderIcon = '<path d="M21 12a9 9 0 1 1-6.219-8.56"/>';

// sampleEventData("campaign.reply_received") from lib/api/models/app/automations/meta.ts.
const sample = `{
  "contact_email": "jane@example.com",
  "contact_id": "00000000-0000-0000-0000-000000000001",
  "campaign_id": "00000000-0000-0000-0000-000000000002",
  "campaign_name": "Q3 Outbound",
  "first_name": "Jane",
  "last_name": "Doe",
  "company": "Example Inc",
  "intent": "positive",
  "confidence": 0.92,
  "subject": "Re: quick question",
  "snippet": "Sure, let's talk next week."
}`;

// Every action node on the canvas, in the order the panel lists them.
const steps = ['Send a Slack message', 'Create a deal', 'Create / update HubSpot contact', 'Add a tag', 'Send a webhook'];

// The dry-run trace, one NodeResultRow each.
type Row = { label: string; kind: 'condition' | 'action'; status: 'ok' | 'branch_true' | 'skipped'; sub?: string; preview?: [string, string][] };
const trace: Row[] = [
  { label: 'IF', kind: 'condition', status: 'branch_true', sub: 'intent is Positive' },
  { label: 'Send a Slack message', kind: 'action', status: 'ok', preview: [['channel', '#sales'], ['text', 'Reply from jane@example.com: "Sure, let\'s talk next week."']] },
  { label: 'Create a deal', kind: 'action', status: 'ok', preview: [['name', 'Jane Doe · Example Inc'], ['stage', 'Discovery'], ['value', '4800']] },
  { label: 'Create / update HubSpot contact', kind: 'action', status: 'ok', preview: [['email', 'jane@example.com'], ['lifecycle_stage', 'opportunity']] },
  { label: 'Add a tag', kind: 'action', status: 'skipped' },
  { label: 'Send a webhook', kind: 'action', status: 'skipped' },
];
---
<div class="ad-root round-clip bg-white ring-1 ring-slate-900/[0.07]" style="box-shadow: 0 50px 110px -32px rgba(2,132,199,0.42), 0 14px 36px -16px rgba(15,23,42,0.18);">
  <!-- browser chrome -->
  <div class="flex items-center gap-2.5 px-3 h-11 border-b border-slate-200/80 bg-gradient-to-b from-[#f7f8fa] to-[#eceef1]">
    <div class="flex items-center gap-2 shrink-0">
      <span class="w-3 h-3 rounded-full bg-[#ff5f57]"></span>
      <span class="w-3 h-3 rounded-full bg-[#febc2e]"></span>
      <span class="w-3 h-3 rounded-full bg-[#28c840]"></span>
    </div>
    <div class="hidden sm:flex items-center gap-1 shrink-0 text-slate-400">
      <span class="grid place-items-center w-6 h-6 rounded-md"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg></span>
      <span class="grid place-items-center w-6 h-6 rounded-md text-slate-300"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg></span>
    </div>
    <div class="flex-1 min-w-0 flex items-center gap-2 h-7 px-3 rounded-lg bg-white ring-1 ring-slate-200/90 text-[12px] shadow-[inset_0_1px_2px_rgba(15,23,42,0.04)]">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="text-emerald-500 shrink-0"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      <span class="truncate font-medium text-slate-700">app.warmbly.com<span class="text-slate-400 font-normal">/automations/reply-to-revenue</span></span>
    </div>
    <div class="hidden sm:flex items-center shrink-0 text-slate-300">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
    </div>
  </div>

  <!-- scale-to-fit screen: 256px shell + 1280px builder -->
  <div class="ad-fit relative w-full overflow-hidden bg-white min-h-[240px]">
    <div class="ad-screen absolute top-0 left-0 origin-top-left" style="width:1536px;">
    <AppShellMock crumb="Automations" sub="Reply to revenue">
    <div class="ad-builder relative flex flex-col" data-demo="ad">

      <!-- ── Builder header ────────────────────────────────────────── -->
      <div class="h-12 px-3 flex items-center gap-2 border-b border-slate-200 bg-white shrink-0">
        <span class="h-7 w-7 rounded-md text-slate-500 inline-flex items-center justify-center"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={arrowLeftIcon}></svg></span>
        <span class="h-7 px-2 w-56 rounded-md text-[13px] font-medium text-slate-900 border border-transparent inline-flex items-center truncate">Reply to revenue</span>
        <span class="inline-flex h-7 items-center gap-2 rounded-md">
          <span class="relative inline-flex h-[18px] w-8 shrink-0 items-center rounded-full bg-sky-600"><span class="inline-block size-3.5 translate-x-[16px] rounded-full bg-white shadow-sm"></span></span>
          <span class="text-[12px] font-medium text-slate-700">Active</span>
        </span>
        <div class="ml-auto flex items-center gap-1.5">
          <span class="h-7 px-2.5 rounded-md border border-slate-200 text-slate-700 text-[12px] inline-flex items-center gap-1.5"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={historyIcon}></svg>History</span>
          <button type="button" class="ad-testbtn h-7 px-2.5 rounded-md border border-slate-200 text-slate-700 text-[12px] inline-flex items-center gap-1.5 transition-colors cursor-pointer select-none [&.is-hover]:border-slate-300 [&.is-hover]:text-slate-900" aria-label="Replay the demo run">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={playIcon}></svg>
            Test
          </button>
          <span class="h-7 px-2.5 rounded-md border border-slate-200 text-slate-700 text-[12px] inline-flex items-center">Tidy up</span>
          <span class="h-7 px-3 rounded-md text-[12px] font-medium inline-flex items-center gap-1.5 bg-slate-100 text-slate-400"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-300" set:html={checkIcon}></svg>Saved</span>
        </div>
      </div>

      <!-- ── Canvas ────────────────────────────────────────────────── -->
      <div class="relative flex-1 min-h-[720px] overflow-hidden bg-slate-50/40" style="background-image: radial-gradient(#e9eef5 0.5px, transparent 0.6px); background-size: 24px 24px;">

        <!-- Panel top-left (15px): Add action split button, Add condition -->
        <div class="absolute left-[15px] top-[15px] z-20 flex items-center gap-1.5">
          <div class="relative inline-flex">
            <span class="inline-flex h-8 items-center gap-1.5 rounded-l-md bg-sky-600 px-2.5 text-[12px] font-medium text-white shadow-sm"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={plusIcon}></svg>Add action</span>
            <span class="inline-flex h-8 items-center rounded-r-md border-l border-sky-500/60 bg-sky-600 px-1.5 text-white shadow-sm"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={chevronIcon}></svg></span>
          </div>
          <span class="inline-flex h-8 items-center gap-1.5 rounded-md border border-slate-200 bg-white px-2.5 text-[12px] font-medium text-slate-700 shadow-sm"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={gitBranchIcon}></svg>Add condition</span>
        </div>

        <!-- Panel bottom-center: the hint -->
        <div class="absolute bottom-[15px] left-1/2 -translate-x-1/2 z-[5] hidden md:block rounded-md bg-white/95 px-3 py-1.5 shadow-sm text-[11px] text-slate-500">drag a node's dot to connect &middot; IF block: right dot = yes, bottom dot = no &middot; drag to empty canvas to pick what comes next &middot; click a line then Delete to remove</div>

        <!-- edges -->
        <svg width="1280" height="720" viewBox="0 0 1280 720" class="absolute inset-0 pointer-events-none" aria-hidden="true">
          <defs>
            <marker id="ad-arrow-slate" viewBox="-10 -10 20 20" markerWidth="16" markerHeight="16" refX="0" refY="0" orient="auto-start-reverse" markerUnits="strokeWidth"><polyline stroke-linecap="round" stroke-linejoin="round" points="-5,-4 0,0 -5,4 -5,-4" fill="#94a3b8" stroke="#94a3b8" stroke-width="1"/></marker>
            <marker id="ad-arrow-light" viewBox="-10 -10 20 20" markerWidth="16" markerHeight="16" refX="0" refY="0" orient="auto-start-reverse" markerUnits="strokeWidth"><polyline stroke-linecap="round" stroke-linejoin="round" points="-5,-4 0,0 -5,4 -5,-4" fill="#cbd5e1" stroke="#cbd5e1" stroke-width="1"/></marker>
            <marker id="ad-arrow-sky" viewBox="-10 -10 20 20" markerWidth="16" markerHeight="16" refX="0" refY="0" orient="auto-start-reverse" markerUnits="strokeWidth"><polyline stroke-linecap="round" stroke-linejoin="round" points="-5,-4 0,0 -5,4 -5,-4" fill="#0ea5e9" stroke="#0ea5e9" stroke-width="1"/></marker>
          </defs>
          <path d="M 444 98 L 444 130" fill="none" stroke="#cbd5e1" stroke-width="1.5" marker-end="url(#ad-arrow-light)"/>
          <path d="M 552 155 C 670 155, 764 168, 764 214" fill="none" stroke="#0ea5e9" stroke-width="1.5" marker-end="url(#ad-arrow-sky)"/>
          <path d="M 444 176 C 444 215, 220 208, 220 254" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ad-arrow-slate)"/>
          <path d="M 764 310 L 764 334" fill="none" stroke="#cbd5e1" stroke-width="1.5" marker-end="url(#ad-arrow-light)"/>
          <path d="M 764 430 L 764 454" fill="none" stroke="#cbd5e1" stroke-width="1.5" marker-end="url(#ad-arrow-light)"/>
          <path d="M 220 346 L 220 382" fill="none" stroke="#cbd5e1" stroke-width="1.5" marker-end="url(#ad-arrow-light)"/>
        </svg>

        <!-- edge labels -->
        <span class="absolute z-10 inline-flex items-center rounded border px-1 py-px text-[10px]" style="left:640px; top:144px; border-color:#0ea5e9; color:#0ea5e9; background:#fff;">yes</span>
        <span class="absolute z-10 inline-flex items-center rounded border px-1 py-px text-[10px]" style="left:308px; top:194px; border-color:#94a3b8; color:#94a3b8; background:#fff;">no</span>

        <!-- TriggerNode -->
        <div class="absolute" style="left:320px; top:22px; width:248px;">
          <div class="relative rounded-xl border border-slate-200 bg-white shadow-sm">
            <div class="flex items-center gap-2 rounded-t-xl border-b border-slate-200/70 bg-gradient-to-r from-sky-50/80 to-white px-2.5 py-1.5">
              <span class="inline-flex size-5 shrink-0 items-center justify-center rounded-md bg-sky-100 text-sky-600 ring-1 ring-sky-200/70"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={zapIcon}></svg></span>
              <span class="text-[9.5px] font-semibold uppercase tracking-[0.12em] text-sky-500">When</span>
              <span class="ml-auto shrink-0 rounded bg-sky-600 px-1.5 py-px text-[9px] font-semibold uppercase tracking-[0.12em] text-white">Trigger</span>
            </div>
            <div class="px-2.5 py-2">
              <div class="truncate text-[12.5px] font-semibold text-slate-800">Prospect replies</div>
            </div>
            <span class="absolute -bottom-1.5 left-1/2 -translate-x-1/2 size-3 rounded-full bg-sky-500 border-2 border-white"></span>
          </div>
        </div>

        <!-- ConditionNode -->
        <div class="absolute" style="left:334px; top:140px;">
          <div class="relative inline-block rounded-lg border border-sky-200 bg-gradient-to-b from-sky-50 to-white px-2 py-1 shadow-sm">
            <span class="absolute -top-1 left-1/2 -translate-x-1/2 size-2 rounded-full bg-slate-300 border-2 border-white"></span>
            <div class="flex items-center gap-1.5">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-sky-600" set:html={gitBranchIcon}></svg>
              <span class="text-[9.5px] font-semibold uppercase tracking-[0.12em] text-sky-500">if</span>
              <span class="max-w-[150px] truncate text-[11px] font-medium text-sky-800">intent is Positive</span>
              <span class="inline-flex size-4 items-center justify-center rounded text-sky-400"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={trashIcon}></svg></span>
            </div>
            <span class="absolute -right-1 top-1/2 -translate-y-1/2 size-3 rounded-full bg-sky-500 border-2 border-white"></span>
            <span class="absolute -bottom-1 left-1/2 -translate-x-1/2 size-3 rounded-full bg-slate-400 border-2 border-white"></span>
          </div>
        </div>

        <!-- ActionNode: Slack -->
        <div class="absolute" style="left:640px; top:222px; width:248px;">
          <div class="relative rounded-xl border border-slate-200 bg-white shadow-sm">
            <div class="flex items-center gap-2 rounded-t-xl border-b border-slate-200/70 bg-gradient-to-r from-slate-50 to-white px-2.5 py-1.5">
              <div class="w-7 h-7 rounded-md ring-1 ring-slate-200 bg-white inline-flex items-center justify-center shrink-0"><svg viewBox="0 0 256 256" role="img" aria-label="slack" class="w-4 h-4" set:html={RAW_BRAND_LOGOS.slack.inner}></svg></div>
              <span class="min-w-0 flex-1 truncate text-[12.5px] font-semibold text-slate-800">Send a Slack message</span>
              <span class="inline-flex size-5 shrink-0 items-center justify-center rounded text-slate-300"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={trashIcon}></svg></span>
            </div>
            <div class="px-2.5 py-2">
              <div class="text-[9.5px] font-semibold uppercase tracking-[0.12em] text-slate-300">Then</div>
              <div class="mt-0.5 truncate text-[11.5px] text-slate-500">Slack</div>
            </div>
            <span class="absolute -top-1 left-1/2 -translate-x-1/2 size-2 rounded-full bg-slate-300 border-2 border-white"></span>
            <span class="absolute -right-[5px] top-1/2 -translate-y-1/2 size-2.5 rounded-full bg-rose-500 border-2 border-white"></span>
            <span class="absolute -bottom-1 left-1/2 -translate-x-1/2 size-3 rounded-full bg-sky-500 border-2 border-white"></span>
          </div>
        </div>

        <!-- ActionNode: Create a deal -->
        <div class="absolute" style="left:640px; top:342px; width:248px;">
          <div class="relative rounded-xl border border-slate-200 bg-white shadow-sm">
            <div class="flex items-center gap-2 rounded-t-xl border-b border-slate-200/70 bg-gradient-to-r from-slate-50 to-white px-2.5 py-1.5">
              <span class="inline-flex size-5 shrink-0 items-center justify-center rounded-md bg-indigo-100 text-indigo-600 ring-1 ring-indigo-200/70"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={zapIcon}></svg></span>
              <span class="min-w-0 flex-1 truncate text-[12.5px] font-semibold text-slate-800">Create a deal</span>
              <span class="inline-flex size-5 shrink-0 items-center justify-center rounded text-slate-300"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={trashIcon}></svg></span>
            </div>
            <div class="px-2.5 py-2">
              <div class="text-[9.5px] font-semibold uppercase tracking-[0.12em] text-slate-300">Then</div>
              <div class="mt-0.5 truncate text-[11.5px] text-slate-500">Built-in action</div>
            </div>
            <span class="absolute -top-1 left-1/2 -translate-x-1/2 size-2 rounded-full bg-slate-300 border-2 border-white"></span>
            <span class="absolute -right-[5px] top-1/2 -translate-y-1/2 size-2.5 rounded-full bg-rose-500 border-2 border-white"></span>
            <span class="absolute -bottom-1 left-1/2 -translate-x-1/2 size-3 rounded-full bg-sky-500 border-2 border-white"></span>
          </div>
        </div>

        <!-- ActionNode: HubSpot -->
        <div class="absolute" style="left:640px; top:462px; width:248px;">
          <div class="relative rounded-xl border border-slate-200 bg-white shadow-sm">
            <div class="flex items-center gap-2 rounded-t-xl border-b border-slate-200/70 bg-gradient-to-r from-slate-50 to-white px-2.5 py-1.5">
              <div class="w-7 h-7 rounded-md ring-1 ring-slate-200 bg-white inline-flex items-center justify-center shrink-0"><svg viewBox="0 0 24 24" role="img" aria-label="hubspot" class="w-4 h-4" fill={BRAND_ICON.hubspot.hex}><path d={BRAND_ICON.hubspot.path}/></svg></div>
              <span class="min-w-0 flex-1 truncate text-[12.5px] font-semibold text-slate-800">Create / update HubSpot contact</span>
              <span class="inline-flex size-5 shrink-0 items-center justify-center rounded text-slate-300"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={trashIcon}></svg></span>
            </div>
            <div class="px-2.5 py-2">
              <div class="text-[9.5px] font-semibold uppercase tracking-[0.12em] text-slate-300">Then</div>
              <div class="mt-0.5 truncate text-[11.5px] text-slate-500">HubSpot</div>
            </div>
            <span class="absolute -top-1 left-1/2 -translate-x-1/2 size-2 rounded-full bg-slate-300 border-2 border-white"></span>
            <span class="absolute -right-[5px] top-1/2 -translate-y-1/2 size-2.5 rounded-full bg-rose-500 border-2 border-white"></span>
            <span class="absolute -bottom-1 left-1/2 -translate-x-1/2 size-3 rounded-full bg-sky-500 border-2 border-white"></span>
          </div>
        </div>

        <!-- ActionNode: Add a tag (the no branch) -->
        <div class="absolute" style="left:96px; top:258px; width:248px;">
          <div class="relative rounded-xl border border-slate-200 bg-white shadow-sm">
            <div class="flex items-center gap-2 rounded-t-xl border-b border-slate-200/70 bg-gradient-to-r from-slate-50 to-white px-2.5 py-1.5">
              <span class="inline-flex size-5 shrink-0 items-center justify-center rounded-md bg-indigo-100 text-indigo-600 ring-1 ring-indigo-200/70"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={zapIcon}></svg></span>
              <span class="min-w-0 flex-1 truncate text-[12.5px] font-semibold text-slate-800">Add a tag</span>
              <span class="inline-flex size-5 shrink-0 items-center justify-center rounded text-slate-300"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={trashIcon}></svg></span>
            </div>
            <div class="px-2.5 py-2">
