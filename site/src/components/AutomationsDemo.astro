                  ))}
                </div>
                <p class="mt-1 text-[10.5px] text-slate-400">Turn a step off to skip it in this test. Conditions still decide which steps are reached.</p>
              </div>
              <span class="ad-run h-8 w-full rounded-md bg-sky-600 text-white text-[12px] font-medium inline-flex items-center justify-center gap-1.5 transition-colors [&.is-hover]:bg-sky-700 [&.is-pressed]:bg-sky-700">
                <span class="ad-run-idle inline-flex items-center gap-1.5"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={playIcon}></svg>Run test</span>
                <span class="ad-run-busy inline-flex items-center gap-1.5"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="animate-spin" set:html={loaderIcon}></svg>Running…</span>
              </span>
              <div class="border-t border-slate-200 pt-3 space-y-2">
