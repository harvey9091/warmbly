---
import Logo from '../components/Logo.astro';
import DemoCursor from './DemoCursor.astro';

/**
 * The /app/analytics screen, 1:1 with web/src/app/app/analytics/page.tsx:
 * PageTopbar with the RangeTabs and Share image button, the four-cell
 * StatStrip, the MultiTrend chart (every metric on one graph, dithered area
 * per series, three gridlines with compact labels, legend pills that toggle
 * a series), the Breakdown and Account health aside, Top campaigns and
 * Recent activity. Rendered as the content panel only; the shell wraps it.
 *
 * The share modal is AnalyticsShareButton's preview: aspect presets with 1:1
 * active by default, the 1080x1080 StatsShareCard drawn at true size and
 * scaled into its 460px preview box, Copy and Download PNG.
 */

// play: the cursor opens and dismisses the share modal on a loop.
// off: the plain screen. open: the modal held open, no cursor.
interface Props { demo?: 'play' | 'off' | 'open' }
const { demo = 'play' } = Astro.props;
const demoClass = demo === 'off' ? 'an-off' : demo === 'open' ? 'an-open' : '';

// daily_trend, Dec 2 to Dec 8. Every series shares one y scale, as MultiTrend does.
const days = ['Dec 2', 'Dec 3', 'Dec 4', 'Dec 5', 'Dec 6', 'Dec 7', 'Dec 8'];
const series = [
  { key: 'sent',    label: 'Sent',    dot: 'bg-sky-500',     rgb: '14,165,233',  values: [380, 420, 350, 480, 440, 410, 367] },
  { key: 'opens',   label: 'Opens',   dot: 'bg-emerald-500', rgb: '16,185,129',  values: [118, 132, 108, 150, 138, 128, 117] },
  { key: 'clicks',  label: 'Clicks',  dot: 'bg-violet-500',  rgb: '139,92,246',  values: [30, 35, 28, 40, 36, 33, 32] },
  { key: 'replies', label: 'Replies', dot: 'bg-amber-500',   rgb: '245,158,11',  values: [7, 9, 6, 10, 9, 8, 7] },
];

// MultiTrend geometry: height 280, 18px tick row, 5px top pad, 1px bottom pad.
// The chart column is 1280 minus the 256 sidebar minus the 300 aside minus
// the 20px padding each side, so the SVG is authored at that width.
const CH_W = 684;
const CH_H = 280;
const TICK_H = 18;
const CHART_H = CH_H - TICK_H - 4;
const PAD_TOP = 5;
const PAD_BOTTOM = 1;
const INNER_H = CHART_H - PAD_TOP - PAD_BOTTOM;
const max = Math.max(...series.flatMap((s) => s.values));
const yOf = (v: number) => PAD_TOP + (1 - v / max) * INNER_H;
const xOf = (i: number) => (i / (days.length - 1)) * CH_W;

// Monotone cubic through the points, the same shape the canvas painter draws.
function monotonePath(vals: number[]) {
  const n = vals.length;
  const xs = vals.map((_, i) => xOf(i));
  const ys = vals.map(yOf);
  const d: number[] = [];
  for (let i = 0; i < n - 1; i++) d.push((ys[i + 1] - ys[i]) / (xs[i + 1] - xs[i]));
  const m: number[] = new Array(n).fill(0);
  m[0] = d[0];
  m[n - 1] = d[n - 2];
  for (let i = 1; i < n - 1; i++) m[i] = d[i - 1] * d[i] <= 0 ? 0 : (d[i - 1] + d[i]) / 2;
  let path = `M ${xs[0].toFixed(1)} ${ys[0].toFixed(1)}`;
  for (let i = 0; i < n - 1; i++) {
    const dx = (xs[i + 1] - xs[i]) / 3;
    path += ` C ${(xs[i] + dx).toFixed(1)} ${(ys[i] + m[i] * dx).toFixed(1)}, ${(xs[i + 1] - dx).toFixed(1)} ${(ys[i + 1] - m[i + 1] * dx).toFixed(1)}, ${xs[i + 1].toFixed(1)} ${ys[i + 1].toFixed(1)}`;
  }
  return path;
}
const curves = series.map((s) => {
  const line = monotonePath(s.values);
  return { ...s, line, area: `${line} L ${CH_W} ${CHART_H} L 0 ${CHART_H} Z` };
});
const compact = (n: number) => (n >= 1000 ? `${(n / 1000).toFixed(1)}k` : `${Math.round(n)}`);
const grid = [0.25, 0.5, 0.75].map((f) => ({ top: PAD_TOP + (1 - f) * INNER_H, label: compact(max * f) }));

const statStrip = [
  { label: 'Total sent',  value: '2,847', sub: 'in range',       accent: true,  last: false },
  { label: 'Open rate',   value: '31.3%', sub: 'after delivery', accent: false, last: false },
  { label: 'Reply rate',  value: '2.0%',  sub: 'incl. positive', accent: false, last: false },
  { label: 'Bounce rate', value: '0.5%',  sub: 'hard + soft',    accent: false, last: true  },
];

const breakdown = [
  { label: 'Sent',    value: '2,847', dot: 'bg-slate-400' },
  { label: 'Opens',   value: '891',   dot: 'bg-emerald-500', note: '142 auto' },
  { label: 'Clicks',  value: '234',   dot: 'bg-violet-500' },
  { label: 'Replies', value: '56',    dot: 'bg-amber-500' },
  { label: 'Bounces', value: '14',    dot: 'bg-rose-500' },
];

const health = [
  { n: '6', label: 'Healthy', tone: 'text-emerald-600' },
  { n: '1', label: 'At risk', tone: 'text-amber-600' },
  { n: '1', label: 'Issues',  tone: 'text-rose-600' },
];

const campaigns = [
  { name: 'Q4 Outreach - Tech Leaders', status: 'active', sent: '850', open: '38.5%', reply: '2.8%' },
  { name: 'Win-back: Former Customers',  status: 'active', sent: '620', open: '26.3%', reply: '1.6%' },
  { name: 'Product Launch Beta Access',  status: 'paused', sent: '480', open: '42.1%', reply: '3.1%' },
];
const statusDot = (s: string) => (s === 'active' ? 'bg-emerald-500' : s === 'paused' ? 'bg-amber-500' : 'bg-slate-300');

// lucide "activity"
const activityPath = '<path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"/>';
const activity = [
  { tone: 'text-emerald-600', verb: 'Opened by',  email: 'sarah.chen@techcorp.com', campaign: 'Q4 Outreach - Tech Leaders', ts: 'Dec 8, 02:32 PM' },
  { tone: 'text-violet-600',  verb: 'Clicked by', email: 'mark.ross@northwind.dev', campaign: 'Win-back: Former Customers',  ts: 'Dec 8, 02:18 PM' },
  { tone: 'text-amber-600',   verb: 'Reply from', email: 'jess@helio.gen',          campaign: 'Product Launch Beta Access',  ts: 'Dec 8, 01:54 PM' },
  { tone: 'text-slate-500',   verb: 'Sent to',    email: 'omar@brightco.io',        campaign: 'Q4 Outreach - Tech Leaders', ts: 'Dec 8, 01:40 PM' },
  { tone: 'text-rose-600',    verb: 'Bounced',    email: 'lena@oldmail.example',    campaign: 'Win-back: Former Customers',  ts: 'Dec 8, 01:12 PM' },
];

// StatsShareCard, 1:1 preset: 1080x1080, drawn at true size and scaled into
// the 460px preview box the modal gives it.
const CARD = 1080;
const PREVIEW = 460;
const SKY_BASE =
  'radial-gradient(ellipse 125% 105% at 50% -12%,' +
  ' #9fe0fb 0%, #74cef7 30%, #4ec1f6 58%, #2fb6f2 82%, #18abed 100%)';
const SKY_BREATHE =
  'radial-gradient(ellipse 125% 105% at 50% -12%,' +
  ' rgba(224,242,254,0.85) 0%, rgba(125,211,252,0.38) 24%, rgba(56,189,248,0.14) 46%, transparent 64%)';
const HAZE_BOTTOM =
  'linear-gradient(to top, rgba(186,230,253,0.40) 0%, rgba(125,211,252,0.16) 42%, transparent 100%)';
const shareMetrics = [
  { label: 'Sent',        value: '2,847', sub: 'emails' },
  { label: 'Open rate',   value: '31.3%' },
  { label: 'Reply rate',  value: '2.0%' },
  { label: 'Bounce rate', value: '0.5%' },
];
// ShareAreaChart: viewBox 1000x320, padX 4, padTop 14, baseline 314.
const sent = series[0].values;
const sMax = Math.max(...sent);
const sPts = sent.map((v, i) => [4 + (i * 992) / (sent.length - 1), 314 - (v / sMax) * 300] as const);
const shareLine = sPts.map(([x, y], i) => `${i === 0 ? 'M' : 'L'} ${x.toFixed(1)} ${y.toFixed(1)}`).join(' ');
const shareArea = `${shareLine} L ${sPts[sPts.length - 1][0].toFixed(1)} 314 L 4 314 Z`;
---
<div class={`an relative w-full bg-white text-slate-900 min-h-full flex flex-col ${demoClass}`} data-demo={demo === 'play' ? 'an' : undefined}>
  <!-- PageTopbar -->
  <div class="min-h-12 @md:h-12 px-5 py-1.5 @md:py-0 border-b border-slate-200 flex flex-wrap @md:flex-nowrap items-center gap-3 gap-y-1.5 shrink-0 bg-white sticky top-0 z-10">
    <span class="text-[10px] uppercase tracking-[0.14em] text-slate-400 font-medium">Analytics</span>
    <div class="h-4 w-px bg-slate-200"></div>
    <span class="text-[12.5px] text-slate-600 truncate">Deliverability across the workspace</span>
    <div class="ml-auto flex items-center gap-1.5 min-w-0 flex-wrap justify-end @md:flex-nowrap">
      <!-- RangeTabs -->
      <div class="inline-flex items-center gap-0.5 rounded-md bg-slate-100 p-0.5">
        <span class="h-7 px-2.5 rounded text-[12px] font-medium bg-white text-slate-900 shadow-sm inline-flex items-center">7d</span>
        <span class="h-7 px-2.5 rounded text-[12px] font-medium text-slate-500 inline-flex items-center">30d</span>
        <span class="h-7 px-2.5 rounded text-[12px] font-medium text-slate-500 inline-flex items-center">90d</span>
      </div>
      <!-- AnalyticsShareButton -->
      <button class="an-share h-7 px-2.5 rounded-md border border-slate-200 text-slate-700 bg-white text-[12px] font-medium inline-flex items-center gap-1.5 transition-colors [&.is-hover]:border-slate-300 [&.is-hover]:text-slate-900">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
        <span class="hidden @sm:inline">Share image</span>
      </button>
    </div>
  </div>

  <!-- StatStrip -->
  <div class="grid border-b border-slate-200 shrink-0 bg-white grid-cols-2 @md:grid-cols-4">
    {statStrip.map((s) => (
      <div class={`group px-5 py-4 transition-colors ${!s.last ? 'border-r border-slate-200' : ''}`}>
        <div class="flex items-center gap-2">
          <span class="text-[10px] uppercase tracking-[0.14em] text-slate-400 font-medium">{s.label}</span>
          {s.accent && <span class="size-1.5 rounded-full bg-sky-500 animate-pulse"></span>}
        </div>
        <div class="text-[26px] text-slate-900 font-light leading-none mt-2 tabular-nums">{s.value}</div>
        <div class="text-[10px] text-slate-400 mt-1.5 font-mono truncate">{s.sub}</div>
      </div>
    ))}
  </div>

  <!-- Performance + aside -->
  <div class="grid @lg:grid-cols-[1fr_300px] min-h-0 flex-1">
    <section class="flex flex-col min-h-0 @lg:border-r @lg:border-slate-200">
      <div class="min-h-9 @md:h-9 px-5 py-1.5 @md:py-0 border-b border-slate-200/60 flex flex-wrap @md:flex-nowrap items-center gap-x-2.5 gap-y-1.5 shrink-0">
        <span class="text-[10px] uppercase tracking-[0.14em] text-slate-400 font-medium">Email performance</span>
        <div class="ml-auto flex items-center gap-1.5 flex-wrap justify-end min-w-0"><div class="inline-flex items-center gap-0.5 rounded-md bg-slate-100 p-0.5 max-w-full overflow-x-auto">
          {series.map((m) => (
            <span class="h-6 px-2 rounded text-[11px] font-medium transition-colors inline-flex items-center gap-1.5 bg-white text-slate-900 shadow-sm">
              <span class={`size-1.5 rounded-full ${m.dot}`}></span>
              {m.label}
            </span>
          ))}
        </div></div>
      </div>
      <div class="flex-1 px-5 py-4">
        <!-- MultiTrend -->
        <div class="relative w-full select-none" style={`height:${CH_H}px;`}>
          {grid.map((g) => (
            <div class="pointer-events-none absolute left-0 right-0" style={`top:${g.top}px;`}>
              <div class="h-px bg-slate-100"></div>
              <span class="absolute right-0 -top-3.5 font-mono text-[9px] tabular-nums text-slate-300">{g.label}</span>
            </div>
          ))}
          <svg class="absolute left-0 top-0 block w-full" style={`height:${CHART_H}px;`} viewBox={`0 0 ${CH_W} ${CHART_H}`} preserveAspectRatio="none" aria-hidden="true">
            <defs>
              <!-- DitherMultiAreaChart: one blended wash, denser under the line, capped at half strength -->
              {curves.map((c) => (
                <linearGradient id={`an-g-${c.key}`} x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color={`rgb(${c.rgb})`} stop-opacity="0.32"/>
                  <stop offset="100%" stop-color={`rgb(${c.rgb})`} stop-opacity="0.05"/>
                </linearGradient>
              ))}
            </defs>
            <g style="mix-blend-mode:multiply;">
              {curves.map((c) => <path d={c.area} fill={`url(#an-g-${c.key})`}/>)}
            </g>
            {curves.map((c) => (
              <path d={c.line} fill="none" stroke={`rgb(${c.rgb})`} stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke"/>
            ))}
          </svg>
          <div class="absolute left-0 right-0 h-px bg-slate-200/80" style={`bottom:${TICK_H}px;`}></div>
          <div class="absolute left-0 right-0 bottom-0 flex justify-between font-mono text-[9.5px] text-slate-400">
            <span>{days[0]}</span>
            <span>{days[days.length - 1]}</span>
          </div>
        </div>
      </div>
    </section>

    <aside class="flex flex-col min-h-0 bg-slate-50/40">
      <div class="h-9 px-5 border-b border-slate-200/60 flex items-center shrink-0">
        <span class="text-[10px] uppercase tracking-[0.14em] text-slate-400 font-medium">Breakdown</span>
      </div>
      <div class="divide-y divide-slate-200/60">
        {breakdown.map((q) => (
          <div class="h-9 px-4 flex items-center gap-2">
            <span class={`size-1.5 rounded-full ${q.dot}`}></span>
            <span class="text-[12px] text-slate-700">{q.label}</span>
            {q.note && <span class="text-[9.5px] text-slate-400 font-mono">{q.note}</span>}
            <span class="ml-auto font-mono text-[11px] text-slate-500 tabular-nums">{q.value}</span>
          </div>
        ))}
      </div>
      <div class="h-9 px-5 border-b border-slate-200/60 flex items-center shrink-0">
        <span class="text-[10px] uppercase tracking-[0.14em] text-slate-400 font-medium">Account health</span>
      </div>
      <div class="px-4 py-3 grid grid-cols-3 gap-2 text-center">
        {health.map((h) => (
          <div>
            <div class={`font-mono text-[18px] tabular-nums leading-none ${h.tone}`}>{h.n}</div>
            <div class="text-[10px] uppercase tracking-[0.12em] text-slate-400 mt-1">{h.label}</div>
          </div>
        ))}
      </div>
    </aside>
  </div>

  <!-- Top campaigns -->
  <div class="h-9 px-5 border-b border-slate-200/60 flex items-center gap-x-2.5 shrink-0">
    <span class="text-[10px] uppercase tracking-[0.14em] text-slate-400 font-medium">Top campaigns</span>
    <span class="ml-auto inline-flex items-center gap-1 text-[11px] text-slate-500">
      All campaigns
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
    </span>
  </div>
  <div class="divide-y divide-slate-200/60">
    {campaigns.map((c) => (
      <div class="group h-11 px-5 flex items-center gap-3 transition-colors">
        <span class={`size-1.5 rounded-full shrink-0 ${statusDot(c.status)}`}></span>
        <span class="text-[12.5px] font-medium text-slate-900 truncate max-w-[40%]">{c.name}</span>
        <span class="ml-auto flex items-center gap-2 @md:gap-4 font-mono text-[11px] text-slate-500 tabular-nums shrink-0">
          <span>{c.sent} sent</span>
          <span class="hidden @md:inline text-emerald-600">{c.open} open</span>
          <span class="text-amber-600">{c.reply} reply</span>
        </span>
      </div>
    ))}
  </div>

  <!-- Recent activity -->
  <div class="h-9 px-5 border-b border-slate-200/60 flex items-center shrink-0">
    <span class="text-[10px] uppercase tracking-[0.14em] text-slate-400 font-medium">Recent activity</span>
  </div>
  <div class="flex-1 min-h-0 overflow-hidden divide-y divide-slate-200/60">
    {activity.map((a) => (
      <div class="h-10 px-5 flex items-center gap-3">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={`shrink-0 ${a.tone}`} set:html={activityPath}></svg>
        <span class="text-[12.5px] text-slate-900 truncate">
          <span class={a.tone}>{a.verb}</span> {a.email}
        </span>
        <span class="text-[11.5px] text-slate-400 truncate hidden @md:inline">{a.campaign}</span>
        <span class="ml-auto font-mono text-[10.5px] text-slate-400 tabular-nums shrink-0">{a.ts}</span>
      </div>
    ))}
  </div>

  <!-- Share image preview modal (AnalyticsShareButton) -->
  <!-- Portaled to the body in the app: fixed over the whole window, centred on the screen. -->
  <div class="an-react fixed inset-0 z-[120] flex items-center justify-center bg-slate-900/30 backdrop-blur-[2px] px-4" aria-hidden="true">
    <div class="an-modal w-full max-w-[min(1203px,860px)] max-h-[calc(900px-2rem)] flex flex-col rounded-lg bg-white border border-slate-200 shadow-[0_24px_48px_-12px_rgba(15,23,42,0.18),0_8px_16px_-8px_rgba(15,23,42,0.1)] overflow-hidden">
      <div class="h-12 px-4 border-b border-slate-200 flex items-center gap-2 shrink-0">
        <span class="text-[10px] uppercase tracking-[0.14em] text-slate-400 font-medium">Share image</span>
        <div class="h-4 w-px bg-slate-200"></div>
        <span class="text-[12.5px] text-slate-600 truncate">Preview before download</span>
        <span class="ml-auto size-7 rounded-md text-slate-400 inline-flex items-center justify-center">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </span>
      </div>

      <div class="px-4 pt-3 flex items-center gap-2 shrink-0">
        <span class="text-[11px] text-slate-500 font-medium">Aspect</span>
        <div class="inline-flex items-center gap-1 rounded-md bg-slate-100 p-0.5">
          <span class="h-7 px-3 rounded text-[12px] font-medium transition-colors bg-sky-600 text-white shadow-sm inline-flex items-center">1:1</span>
          <span class="h-7 px-3 rounded text-[12px] font-medium transition-colors text-slate-600 inline-flex items-center">3:2</span>
          <span class="h-7 px-3 rounded text-[12px] font-medium transition-colors text-slate-600 inline-flex items-center">16:9</span>
        </div>
      </div>

      <div class="px-4 py-4 bg-slate-50/40 flex-1 min-h-0 overflow-y-auto flex justify-center items-start">
        <div class="relative max-w-full rounded-md border border-slate-200 bg-white overflow-hidden" style={`aspect-ratio:1/1; width:min(100%, min(${PREVIEW}px, 522px));`}>
          <!-- StatsShareCard at 1080x1080, scaled to the preview -->
          <div class="absolute top-0 left-0 origin-top-left overflow-hidden" style={`width:${CARD}px; height:${CARD}px; transform:scale(${PREVIEW / CARD}); background:${SKY_BASE};`}>
            <div class="absolute inset-0 overflow-hidden pointer-events-none">
              <div class="absolute inset-0" style={`background:${SKY_BREATHE}; opacity:0.6;`}></div>
              <div class="absolute inset-x-0 bottom-0" style={`height:55%; background:${HAZE_BOTTOM};`}></div>
            </div>
            <div class="relative z-10 flex flex-col h-full" style="padding:48px;">
              <div class="flex items-center justify-between">
                <div class="inline-flex items-center gap-3.5">
                  <Logo class="w-[54px] h-[54px] text-white" />
                  <span class="text-white font-extrabold tracking-tight" style="font-family:var(--font-display); font-size:36px;">Warmbly</span>
                </div>
                <span class="font-mono text-[15px] tabular-nums text-white/85">Dec 8, 2025</span>
              </div>
              <div class="mt-6 flex-1 flex flex-col min-h-0" style="background:#ffffff; border-radius:26px; border:1px solid rgba(255,255,255,0.85);">
                <div class="flex flex-col h-full" style="padding:40px;">
                  <div class="text-[14px] font-semibold uppercase tracking-[0.16em] text-sky-600">Last 7 days</div>
                  <h1 class="mt-2 font-semibold leading-tight tracking-tight text-slate-900 line-clamp-2 break-words" style="font-size:40px;">Workspace performance</h1>
                  <div class="mt-8 grid grid-cols-4 divide-x divide-slate-200">
                    {shareMetrics.map((m) => (
                      <div class="px-7 first:pl-0 last:pr-0">
                        <div class="text-[14px] font-medium uppercase tracking-[0.14em] text-slate-400">{m.label}</div>
                        <div class="mt-2.5 font-mono leading-none tabular-nums text-slate-900" style="font-size:46px;">{m.value}</div>
                        {m.sub && <div class="mt-2 text-[14px] text-slate-400">{m.sub}</div>}
                      </div>
                    ))}
                  </div>
                  <div class="mt-8 h-px bg-slate-200/70"></div>
                  <div class="mt-6 flex items-center justify-between">
                    <span class="text-[14px] font-medium uppercase tracking-[0.14em] text-slate-400">Sends over time</span>
                  </div>
                  <div class="mt-4 flex-1 min-h-0 flex flex-col">
                    <div class="relative flex-1 min-h-0">
                      <svg viewBox="0 0 1000 320" preserveAspectRatio="none" width="100%" height="100%" style="display:block;">
                        <defs>
                          <linearGradient id="anShareArea" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0%" stop-color="#0ea5e9" stop-opacity="0.28"/>
                            <stop offset="100%" stop-color="#0ea5e9" stop-opacity="0"/>
                          </linearGradient>
                        </defs>
                        <path d={shareArea} fill="url(#anShareArea)"/>
                        <path d={shareLine} fill="none" stroke="#0284c7" stroke-width="3" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke"/>
                        <line x1="4" y1="314" x2="996" y2="314" stroke="#cbd5e1" stroke-width="2" vector-effect="non-scaling-stroke"/>
                      </svg>
                    </div>
                    <div class="mt-3 flex justify-between font-mono text-[12px] tabular-nums text-slate-400">
                      <span>{days[0]}</span>
                      <span>{days[days.length - 1]}</span>
                    </div>
                  </div>
                </div>
              </div>
              <div class="mt-5 flex items-center justify-between text-[16px]">
                <span class="text-white font-semibold">warmbly.com</span>
                <span class="text-white/80">Cold email, warmed up.</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="px-4 py-3 border-t border-slate-200 flex items-center justify-end gap-2 shrink-0">
        <span class="h-8 px-3 rounded-md border border-slate-200 bg-white text-slate-700 text-[12px] font-medium inline-flex items-center gap-1.5 transition-colors">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
          Copy
        </span>
        <span class="h-8 px-3 rounded-md bg-sky-600 text-white text-[12px] font-medium inline-flex items-center gap-1.5 transition-colors">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
          Download PNG
        </span>
      </div>
    </div>
  </div>

  <DemoCursor />

  <!-- Scene styles: AnalyticsShareButton's own enter and exit (scrim fade,
       card 8px lift + 0.97 scale over 180ms ease-out), driven by .is-open. -->
  <style>
    .an-react{opacity:0;pointer-events:none;transition:opacity .3s ease-out;}
    .an-modal{opacity:0;transform:translateY(8px) scale(.97);transform-origin:center;transition:opacity .18s ease-out,transform .18s ease-out;}
    .an.is-open .an-react{opacity:1;}
    .an.is-open .an-modal{opacity:1;transform:none;}
    /* demo="off": the bare screen. demo="open": the modal held open, no cursor. */
    .an-off .an-react,.an-off .demo-cursor,.an-open .demo-cursor{display:none;}
    .an-open .an-react,.an-open .an-modal{opacity:1;transform:none;transition:none;}
    .an.is-static .an-react{display:none;}
  </style>
</div>

<script>
  import { playCursor } from '../lib/cursor';
  document.querySelectorAll<HTMLElement>('[data-demo="an"]').forEach((root) => {
    playCursor(root, {
      loop: 11000,
      steps: [
        { at: 0, x: 30, y: 80 },
        { at: 2400, el: '.an-share', ox: 0.5, oy: 0.55, hover: '.an-share' },
        { at: 2540, press: true, target: '.an-share', add: ['is-open'] },
        { at: 5800, x: 8, y: 16 },
        { at: 5940, press: true, remove: ['is-open'] },
        { at: 8600, x: 30, y: 80 },
      ],
    });
  });
</script>
