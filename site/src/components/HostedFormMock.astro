---
/**
 * The public form page on the customer's own domain (forms/src FormPage,
 * split layout): what a visitor sees when they open the link a campaign
 * sent them. Rendered under the browser chrome alone, no app shell, at the
 * same 900px viewport height as the app slides. The page is `.wf`: the
 * #f8fafc page background with the form filling the viewport.
 */
import FormCardMock from './FormCardMock.astro';
---
<div class="relative w-full h-[900px] flex flex-col overflow-hidden" style="background:#f8fafc;">
  <div class="flex-1 min-h-0 flex [&>*]:flex-1">
    <FormCardMock />
  </div>
</div>
