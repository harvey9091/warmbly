const tabs = [
  { label: 'Overview', icon: 'barchart' },
  { label: 'Leads', icon: 'users' },
  { label: 'Steps', icon: 'listchecks', active: true },
  { label: 'Schedule', icon: 'calendar' },
  { label: 'Settings', icon: 'settings2' },
];

// NodeTypeSwitcher items: Send email, Switch, AI step, then ADD_ACTION_OPTIONS.
const activeType = demo === 'switch' ? 'Switch (AI / value)' : demo === 'agent' ? 'AI step (agent)' : 'Send email';
const stepTypes = [
  { label: 'Send email', icon: 'mail', tint: 'text-sky-600' },
  { label: 'Switch (AI / value)', icon: 'split', tint: 'text-purple-600' },
  { label: 'AI step (agent)', icon: 'sparkles', tint: 'text-purple-600' },
  { label: 'Add tag', icon: 'tag', tint: 'text-emerald-600' },
  { label: 'Remove tag', icon: 'tag', tint: 'text-amber-600' },
  { label: 'Add to segment', icon: 'layers', tint: 'text-emerald-600' },
  { label: 'Remove from segment', icon: 'layers', tint: 'text-amber-600' },
  { label: 'Label email', icon: 'tags', tint: 'text-fuchsia-600' },
  { label: 'Create task', icon: 'checksquare', tint: 'text-violet-600' },
  { label: 'Create deal', icon: 'handshake', tint: 'text-emerald-600' },
  { label: 'Move deal stage', icon: 'arrowsLR', tint: 'text-sky-600' },
  { label: 'Unsubscribe', icon: 'belloff', tint: 'text-rose-600' },
  { label: 'Run automation', icon: 'zap', tint: 'text-indigo-600' },
  { label: 'Fire event', icon: 'send', tint: 'text-sky-600' },
].map((t) => ({ ...t, active: t.label === activeType }));

// Toolbar of RichTextEditor, in order.
const tools = ['bold', 'italic', 'underline', 'strike', '|', 'h2', 'list', 'listOrdered', 'link2', '|'];

// ── The graph ────────────────────────────────────────────────────
// Handles are `id:key` with a direction the edge leaves or enters by.
type StepN = { kind: 'step'; id: string; x: number; y: number; name: string; subject: string; start?: boolean; selected?: boolean };
type IfN = { kind: 'if'; id: string; x: number; y: number; label: string; instant?: boolean };
type ActionN = { kind: 'action'; id: string; x: number; y: number; name: string; meta: string; icon: string; tint: string; subtitle: string; ends?: boolean; selected?: boolean };
type SwitchN = { kind: 'switch'; id: string; x: number; y: number; name: string; subtitle: string; cases: string[]; selected?: boolean };
type StopN = { kind: 'stop'; id: string; x: number; y: number };
type N = StepN | IfN | ActionN | SwitchN | StopN;
type E = { from: string; to: string; style: 'cond' | 'case' | 'plain'; label?: string };

const stepBody = (x: number, y: number, name: string, subject: string, extra: Partial<StepN> = {}): StepN =>
  ({ kind: 'step', id: name.toLowerCase().replace(/[^a-z]+/g, ''), x, y, name, subject, ...extra });

let nodes: N[];
let edges: E[];
if (demo === 'switch') {
  nodes = [
    stepBody(40, 0, 'First email', 'Quick question, {{.FirstName}}', { id: 'first', start: true }),
    { kind: 'switch', id: 'sw', x: 40, y: 150, name: 'Route the reply', subtitle: 'Read this contact\'s reply and company details. Decide whether…', cases: ['interested', 'not ready yet', 'wrong person'], selected: true },
    { kind: 'action', id: 'deal', x: 420, y: 96, name: 'Open a deal', meta: 'Create deal', icon: 'handshake', tint: 'text-emerald-600', subtitle: 'Create a CRM deal', ends: true },
    stepBody(420, 236, 'Check back later', 'Circling back next quarter', { id: 'later' }),
    { kind: 'stop', id: 'stop', x: 420, y: 400 },
  ];
  edges = [
    { from: 'first:s', to: 'sw', style: 'plain', label: 'wait 3d' },
    { from: 'sw:c0', to: 'deal', style: 'case', label: 'interested' },
    { from: 'sw:c1', to: 'later', style: 'case', label: 'not ready yet · wait 90d' },
    { from: 'sw:c2', to: 'stop', style: 'case', label: 'wrong person' },
  ];
} else if (demo === 'agent') {
  nodes = [
    stepBody(40, 0, 'First email', 'Quick question, {{.FirstName}}', { id: 'first', start: true }),
    { kind: 'action', id: 'ai', x: 40, y: 150, name: 'Triage the reply', meta: 'AI step', icon: 'sparkles', tint: 'text-purple-600', subtitle: 'Agent · 3 actions', ends: true, selected: true },
  ];
  edges = [{ from: 'first:s', to: 'ai', style: 'plain', label: 'wait 3d' }];
} else {
  nodes = [
    stepBody(236, 0, 'First email', 'Quick question, {{.FirstName}}', { id: 'first', start: true, selected: demo === 'ai' }),
    { kind: 'if', id: 'if1', x: 262, y: 150, label: 'opened the email within 3d', instant: true },
    stepBody(464, 218, 'Follow-up', 'Following up on my message', { id: 'followup' }),
    stepBody(56, 218, 'Alternative', 'Trying a different angle', { id: 'alt' }),
    { kind: 'action', id: 'tag', x: 464, y: 372, name: 'Add engagement tag', meta: 'Add tag', icon: 'tag', tint: 'text-emerald-600', subtitle: 'Add a tag', ends: true },
    { kind: 'stop', id: 'stop', x: 148, y: 384 },
  ];
  edges = [
    { from: 'first:s', to: 'if1', style: 'cond' },
    { from: 'if1:out', to: 'followup', style: 'cond', label: 'instant <=3d' },
    { from: 'if1:else', to: 'alt', style: 'plain', label: 'else · wait 2d' },
    { from: 'followup:s', to: 'tag', style: 'plain' },
    { from: 'alt:s', to: 'stop', style: 'plain' },
  ];
}

// Edge strokes and label colours from CampaignFlow.tsx (edgeStyle + the
// per-edge labelStyle / labelBgStyle).
const edgeLook = {
  cond: { stroke: '#0ea5e9', width: 2, marker: 'sky', fg: '#0369a1', bg: '#bae6fd' },
  case: { stroke: '#a855f7', width: 2, marker: 'purple', fg: '#7e22ce', bg: '#e9d5ff' },
  plain: { stroke: '#94a3b8', width: 1, marker: 'slate', fg: '#475569', bg: '#e2e8f0' },
};

const selected = nodes.find((n) => 'selected' in n && n.selected);
const panelTitle = selected && 'name' in selected ? selected.name : 'First email';

// What the assistant writes at the caret (ai demo).
const written = [
  'Noticed Acme has been scaling fast on AWS. Teams your size are usually overpaying 30 to 40 percent on compute they spun up once and never tuned.',
  "I help engineering teams find that spend without re-architecting anything. Worth a quick 15-minute call to walk through the three line items I'd check first?",
  'Open to next Tuesday or Wednesday afternoon?',
];

// AIStepFields: the allowlist, with what this step enables.
const agentActions = [
  { id: 'add_tag', label: 'Add tag', icon: 'tag', tint: 'text-emerald-600', on: true, pool: 'Tags the agent can add' },
  { id: 'remove_tag', label: 'Remove tag', icon: 'tag', tint: 'text-amber-600', on: false },
  { id: 'label_email', label: 'Label email', icon: 'tags', tint: 'text-fuchsia-600', on: false },
  { id: 'unsubscribe', label: 'Unsubscribe', icon: 'belloff', tint: 'text-rose-600', on: true },
  { id: 'create_task', label: 'Create task', icon: 'checksquare', tint: 'text-violet-600', on: true },
  { id: 'create_deal', label: 'Create deal', icon: 'handshake', tint: 'text-emerald-600', on: false },
  { id: 'move_deal_stage', label: 'Move deal stage', icon: 'arrowsLR', tint: 'text-sky-600', on: false },
];

const rootClass = ['cb relative w-full bg-white text-slate-900 flex flex-col', open ? 'is-open' : ''].join(' ');
---
<div class={rootClass} data-demo={play ? 'cb' : undefined} data-scene={demo}>
  <!-- Campaign header (layout.tsx) -->
  <div class="px-5 pt-4 pb-3 flex items-start gap-3">
    <div class="min-w-0">
      <span class="inline-flex items-center gap-1 h-6 -ml-1.5 px-1.5 mb-1 rounded-md text-[11.5px] text-slate-500">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ic.arrowLeft}></svg>
        Campaigns
      </span>
      <div class="flex items-center gap-2">
        <h1 class="text-[18px] font-semibold text-slate-900 truncate">Q1 Sales Outreach</h1>
        <span class="shrink-0 inline-flex items-center h-5 px-2 rounded-md border text-[10px] uppercase tracking-[0.12em] font-medium bg-slate-100 text-slate-600 border-slate-200">draft</span>
      </div>
      <p class="text-[11px] text-slate-400 font-mono mt-1 truncate">cmp_8fK2pQ7rXa19</p>
    </div>
    <div class="ml-auto shrink-0 flex items-center gap-1.5">
      <button type="button" class="h-7 px-2.5 rounded-md bg-sky-600 text-white text-[12px] font-medium inline-flex items-center gap-1.5">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ic.play}></svg>
        Start
      </button>
      <button type="button" aria-label="More actions" class="h-7 w-7 rounded-md border border-slate-200 text-slate-500 inline-flex items-center justify-center">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ic.more}></svg>
      </button>
    </div>
  </div>

  <!-- Tab bar -->
  <div class="shrink-0 px-3 flex items-center gap-1 border-b border-slate-200 overflow-x-auto no-scrollbar">
    {tabs.map((t) => (
      <div class={`relative h-10 px-2.5 inline-flex items-center gap-1.5 text-[12.5px] ${t.active ? 'text-slate-900 font-medium' : 'text-slate-500'}`}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ic[t.icon]}></svg>
        {t.label}
        {t.active && <span class="absolute left-1.5 right-1.5 -bottom-px h-0.5 rounded-full bg-sky-600"></span>}
      </div>
    ))}
  </div>

  <!-- Steps page body: the flow canvas -->
  <div class="p-5">
    <!-- sm:h-[78vh] in the app; the shell is a 900px viewport, so 702px. -->
    <div class="cb-flow relative h-[702px] w-full overflow-hidden rounded-md border border-slate-200 bg-slate-50/40">
      <!-- React Flow Background: dots, gap 24, size 1, #e9eef5 -->
