  <style>
    /* Edit panel: mounted on click, unmounted on close, no transition (as in the app). */
    /* SidePanel's spring (stiffness 300, damping 32): x 100% -> 0 in about 450ms, no visible overshoot; out the same way. */
    .cb-edit { transform: translateX(100%); visibility: hidden; transition: transform .45s cubic-bezier(.22,.85,.35,1), visibility 0s .45s; }
    .cb.is-open .cb-edit { transform: none; visibility: visible; transition: transform .45s cubic-bezier(.22,.85,.35,1), visibility 0s; }
    /* The clicked node is the selected one while its editor is open. */
    .cb.is-open [data-selected] > .cb-node, .cb.is-open .is-selected > .cb-node { border-color: #38bdf8; box-shadow: 0 0 0 2px #e0f2fe, 0 1px 2px 0 rgb(0 0 0 / .05); }
    .cb.is-open [data-selected] > .cb-switch { border-color: #c084fc; box-shadow: 0 0 0 2px #f3e8ff, 0 1px 2px 0 rgb(0 0 0 / .05); }
    /* Merge chips inside the editor body (.tpl-var in the app). */
    .cb-var {
      display: inline-flex; align-items: center; gap: 0.2rem; height: 1.25rem; padding: 0 0.375rem;
      border-radius: 0.25rem; border: 1px solid #e2e8f0; background: #f8fafc; color: #475569;
      font-size: 11px; line-height: 1; font-weight: 500; white-space: nowrap; vertical-align: baseline;
    }
    .cb-body p { margin: 0 0 0.6em; }
    .cb-body p:last-child { margin-bottom: 0; }
    /* DitherMeter: emerald fill on a slate-200 track, dithered ramp at the edge. */
    .cb-meter { background: #e2e8f0; }
    .cb-meter > span { display: block; height: 100%; position: relative; background: #10b981; }
    .cb-meter > span::after {
      content: ''; position: absolute; right: 0; top: 0; width: 6px; height: 100%;
      background: repeating-conic-gradient(#10b981 0 25%, #e2e8f0 0 50%) 0 0 / 2px 2px;
    }

    /* ── The caret assistant (ai demo) ── */
    .cb-caret { display: inline-block; width: 1px; height: 15px; background: #0f172a; vertical-align: text-bottom; animation: cb-blink 1s step-end infinite; }
    @keyframes cb-blink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
    /* Companion: only while the editor is focused; fades and shrinks away while the menu is open (120ms). */
    .cb-spark { transition: opacity .12s ease-out, transform .12s ease-out; }
    .cb:not(.is-open) .cb-spark { display: none; }
    .cb.is-ai .cb-spark { opacity: 0; transform: scale(.9); }
    /* Menu: 120ms fade, one of three panes at a time. */
    .cb-menu { opacity: 0; pointer-events: none; transition: opacity .12s ease-out; }
    .cb.is-ai .cb-menu { opacity: 1; }
    .cb-busy, .cb-applied { display: none; }
    .cb.is-busy .cb-idle, .cb.is-applied .cb-idle { display: none; }
    .cb.is-busy .cb-busy { display: flex; }
    .cb.is-applied .cb-applied { display: flex; }
    /* The instruction is typed in; the submit arrow is disabled until then. */
    .cb-instr { display: none; overflow: hidden; white-space: nowrap; }
    .cb-caret-input { display: none; }
    .cb.is-ai .cb-caret-input { display: inline-block; }
    .cb.is-typing .cb-placeholder { display: none; }
    .cb.is-typing .cb-instr { display: inline-block; animation: cb-type 1.5s steps(46, end) forwards; }
    @keyframes cb-type { from { max-width: 0; } to { max-width: 100%; } }
    .cb-submit { opacity: .4; }
    .cb.is-typing .cb-submit { opacity: 1; }
    /* The written copy lands at the caret all at once, as an insert does. */
    .cb-gen { display: none; }
    .cb.is-applied .cb-gen { display: block; }
    .cb.is-applied .cb-empty { display: none; }
    .cb.is-applied .cb-save { opacity: 1; }

    /* Reduced motion: hold the load-bearing state still. */
    .cb.is-static .cb-edit { transform: none; visibility: visible; transition: none; }
    .cb.is-static[data-scene="flow"] [data-node="first"] > .cb-node { border-color: #38bdf8; box-shadow: 0 0 0 2px #e0f2fe, 0 1px 2px 0 rgb(0 0 0 / .05); }
    .cb.is-static .cb-gen { display: block; }
    .cb.is-static .cb-empty, .cb.is-static .cb-spark, .cb.is-static .cb-menu { display: none; }
  </style>
</div>

<script>
  import { playCursor } from '../lib/cursor';

  type Pt = { x: number; y: number; dir: [number, number] };

  // getNaturalPath from CampaignFlow.tsx: a cubic whose control lengths
  // scale with the gap and shrink when the target sits behind the exit.
  function naturalPath(s: Pt, t: Pt): [string, number, number] {
    const dist = Math.hypot(t.x - s.x, t.y - s.y) || 1;
    const base = Math.max(34, Math.min(dist * 0.5, 160));
    const sAlong = ((t.x - s.x) * s.dir[0] + (t.y - s.y) * s.dir[1]) / dist;
    const sLen = base * (0.32 + 0.68 * Math.max(0, sAlong));
    const tAlong = ((s.x - t.x) * t.dir[0] + (s.y - t.y) * t.dir[1]) / dist;
    const tLen = base * (0.32 + 0.68 * Math.max(0, tAlong));
    const c1x = s.x + s.dir[0] * sLen;
    const c1y = s.y + s.dir[1] * sLen;
    const c2x = t.x + t.dir[0] * tLen;
    const c2y = t.y + t.dir[1] * tLen;
    const d = `M${s.x},${s.y} C${c1x},${c1y} ${c2x},${c2y} ${t.x},${t.y}`;
    return [d, (s.x + 3 * c1x + 3 * c2x + t.x) / 8, (s.y + 3 * c1y + 3 * c2y + t.y) / 8];
  }

  const DIR: Record<string, [number, number]> = { u: [0, -1], d: [0, 1], r: [1, 0] };

  function drawEdges(root: HTMLElement) {
    const layer = root.querySelector<HTMLElement>('.cb-layer');
    if (!layer) return;
    const lr = layer.getBoundingClientRect();
    const k = lr.width ? layer.offsetWidth / lr.width : 1;
    const centre = (id: string): Pt | null => {
      const el = layer.querySelector<HTMLElement>(`[data-handle="${id}"]`);
      if (!el) return null;
      const r = el.getBoundingClientRect();
      return { x: (r.left - lr.left + r.width / 2) * k, y: (r.top - lr.top + r.height / 2) * k, dir: DIR[el.dataset.dir ?? 'd'] ?? [0, 1] };
    };
    layer.querySelectorAll<SVGPathElement>('path[data-from]').forEach((p) => {
      const s = centre(p.dataset.from ?? '');
      const t = centre(`${p.dataset.to}:t`);
      if (!s || !t) return;
      const [d, lx, ly] = naturalPath(s, t);
      p.setAttribute('d', d);
      const label = layer.querySelector<HTMLElement>(`[data-label-for="${p.dataset.from}"]`);
      if (label) label.style.transform = `translate(-50%, -50%) translate(${lx}px, ${ly}px)`;
    });
  }

  // RichTextAICaret's placement: the companion at the caret line's top, 28px
  // in from the editor's right edge; the menu bottom-start off the caret, 8px
  // down. Both are fixed inside the shell, so boxes are converted to shell px
  // (the shell is scaled by the frame). Once the copy has landed the caret line
  // is gone, so the last measured box holds, like the app's frozen position.
  function placeCaretUI(root: HTMLElement) {
    const spark = root.querySelector<HTMLElement>('.cb-spark');
    const menu = root.querySelector<HTMLElement>('.cb-menu');
    const line = root.querySelector<HTMLElement>('[data-caret-line]');
    const editor = root.querySelector<HTMLElement>('[data-editor]');
    if (!spark || !menu || !line || !editor) return;
    const stage = root.closest<HTMLElement>('[data-stage]') ?? root;
    const sr = stage.getBoundingClientRect();
    if (!sr.width) return;
    const k = stage.offsetWidth / sr.width;
    const lr = line.getBoundingClientRect();
    if (!lr.height) return;
    const er = editor.getBoundingClientRect();
    const top = (lr.top - sr.top) * k;
    const left = (lr.left - sr.left) * k;
    spark.style.top = `${top - 1}px`;
    spark.style.left = `${(er.right - sr.left) * k - 28}px`;
    menu.style.top = `${top + lr.height * k + 8}px`;
    // floating-ui shift({ padding: 8 }): the menu stays inside the viewport.
    menu.style.left = `${Math.max(8, Math.min(left, stage.offsetWidth - menu.offsetWidth - 8))}px`;
  }

  document.querySelectorAll<HTMLElement>('.cb').forEach((root) => {
    const draw = () => { drawEdges(root); placeCaretUI(root); };
    draw();
    requestAnimationFrame(draw);
    window.addEventListener('load', draw);
    if (document.fonts?.ready) document.fonts.ready.then(draw);
    new ResizeObserver(draw).observe(root);
    // The panel's contents reflow as the scene's classes change.
    new MutationObserver(draw).observe(root, { attributes: true, attributeFilter: ['class'] });
  });

  // The flow demo: click the first step, the panel mounts, close it again.
  document.querySelectorAll<HTMLElement>('[data-demo="cb"][data-scene="flow"]').forEach((root) => {
    playCursor(root, {
      loop: 11000,
      steps: [
        { at: 0, x: 22, y: 78 },
        { at: 2400, el: '[data-node="first"]', ox: 0.55, oy: 0.42 },
        { at: 2520, press: true, target: '[data-node="first"]', add: ['is-open'] },
        { at: 2520, add: ['is-selected'], on: '[data-node="first"]' },
        { at: 5800, el: '[data-cb="close"]', ox: 0.5, oy: 0.55, hover: '[data-cb="close"]' },
        { at: 5940, press: true, target: '[data-cb="close"]', remove: ['is-open'] },
        { at: 5940, remove: ['is-selected'], on: '[data-node="first"]' },
        { at: 8600, x: 22, y: 78 },
      ],
    });
  });

  // The ai demo: the sparkle on the caret line opens the menu, the
  // instruction is typed and sent, the copy lands, Done closes the menu.
  document.querySelectorAll<HTMLElement>('[data-demo="cb"][data-scene="ai"]').forEach((root) => {
    playCursor(root, {
      loop: 12500,
      steps: [
        { at: 0, x: 14, y: 70 },
        { at: 2200, el: '[data-ai="spark"]', ox: 0.5, oy: 0.55, hover: '[data-ai="spark"]' },
        { at: 2340, press: true, add: ['is-ai'] },
        { at: 2900, add: ['is-typing'] },
        { at: 5400, el: '[data-ai="submit"]', ox: 0.5, oy: 0.55, hover: '[data-ai="submit"]' },
        { at: 5540, press: true, target: '[data-ai="submit"]', add: ['is-busy'] },
        { at: 7100, add: ['is-applied'], remove: ['is-busy'] },
        { at: 9200, el: '[data-ai="done"]', ox: 0.5, oy: 0.55, hover: '[data-ai="done"]' },
        { at: 9340, press: true, target: '[data-ai="done"]', remove: ['is-ai'] },
        { at: 11400, x: 14, y: 70 },
      ],
    });
  });
</script>
