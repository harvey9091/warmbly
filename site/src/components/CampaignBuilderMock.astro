            <marker id="cb-arrow-purple" viewBox="-10 -10 20 20" markerWidth="16" markerHeight="16" refX="0" refY="0" orient="auto-start-reverse" markerUnits="strokeWidth"><polyline stroke-linecap="round" stroke-linejoin="round" points="-5,-4 0,0 -5,4 -5,-4" fill="#a855f7" stroke="#a855f7" stroke-width="1"/></marker>
