---
/**
 * The form builder (/app/forms/:id, Build tab) as FormBuilder.tsx draws it:
 * h-14 header with the name field and status, the six-tab bar, then the
 * palette (w-52), the canvas with the live card, and the field settings
 * panel (w-80) for the field that is selected on the canvas.
 */
import FormCardMock from './FormCardMock.astro';

const paletteFields = [
  { label: 'Text', icon: '<path d="M12 4v16"/><path d="M4 7V5a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v2"/><path d="M9 20h6"/>' },
  { label: 'Email', icon: '<circle cx="12" cy="12" r="4"/><path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-4 8"/>' },
  { label: 'Phone', icon: '<path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384z"/>' },
  { label: 'Long text', icon: '<line x1="21" x2="3" y1="6" y2="6"/><line x1="15" x2="3" y1="12" y2="12"/><line x1="17" x2="3" y1="18" y2="18"/>' },
  { label: 'Number', icon: '<line x1="4" x2="20" y1="9" y2="9"/><line x1="4" x2="20" y1="15" y2="15"/><line x1="10" x2="8" y1="3" y2="21"/><line x1="16" x2="14" y1="3" y2="21"/>' },
  { label: 'Dropdown', icon: '<rect width="18" height="18" x="3" y="3" rx="2"/><path d="m8 10 4 4 4-4"/>' },
  { label: 'Radio buttons', icon: '<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="1"/>' },
  { label: 'Checkbox group', icon: '<path d="m3 17 2 2 4-4"/><path d="m3 7 2 2 4-4"/><path d="M13 6h8"/><path d="M13 12h8"/><path d="M13 18h8"/>' },
  { label: 'Single checkbox', icon: '<path d="M21 10.656V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11.344"/><path d="m9 11 3 3L22 4"/>' },
  { label: 'Date', icon: '<rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>' },
  { label: 'Hidden field', icon: '<path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"/><path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"/><path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"/><path d="m2 2 20 20"/>' },
];
const paletteLayout = [
  { label: 'Heading', icon: '<path d="M6 12h12"/><path d="M6 20V4"/><path d="M18 20V4"/>' },
  { label: 'Text block', icon: '<path d="M17 6.1H3"/><path d="M21 12.1H3"/><path d="M15.1 18H3"/>' },
  { label: 'Divider', icon: '<path d="M5 12h14"/>' },
  { label: 'Page break', icon: '<path d="M3 12h18"/><path d="m8 8 4-4 4 4"/><path d="m16 16-4 4-4-4"/>' },
];

const tabs = [
  { label: 'Build', on: true, icon: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>' },
  { label: 'Design', icon: '<path d="M12 22a1 1 0 0 1 0-20 10 9 0 0 1 10 9 5 5 0 0 1-5 5h-2.25a1.75 1.75 0 0 0-1.4 2.8l.3.4a1.75 1.75 0 0 1-1.4 2.8z"/><circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/>' },
  { label: 'Settings', icon: '<path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/>' },
  { label: 'Share', icon: '<circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/>' },
  { label: 'Analytics', icon: '<line x1="18" x2="18" y1="20" y2="10"/><line x1="12" x2="12" y1="20" y2="4"/><line x1="6" x2="6" y1="20" y2="14"/>' },
  { label: 'Submissions', badge: '1,041', icon: '<polyline points="22 12 16 12 14 15 10 15 8 12 2 12"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/>' },
];

// TextInput and Label from ui/field.tsx: a bare input keeps the browser's default width.
const field = 'h-7 w-[178px] px-2.5 rounded-md border border-slate-200 bg-white text-[12.5px] text-slate-900 flex items-center min-w-0';
const label = 'text-[10px] uppercase tracking-[0.14em] text-slate-400 font-medium block mb-1.5';
---
<div class="h-full min-h-[844px] flex flex-col bg-white text-slate-900">
  <!-- Header -->
  <div class="shrink-0 px-4 h-14 flex items-center gap-3 border-b border-slate-200 bg-white">
    <span class="inline-flex items-center gap-1 text-[12px] text-slate-500 shrink-0">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
      Forms
    </span>
    <div class="w-px h-5 bg-slate-200 shrink-0"></div>
    <div class="h-7 w-[178px] max-w-[260px] rounded-md border border-slate-200 bg-white px-2.5 flex items-center text-[12.5px] font-medium text-slate-900 min-w-0">Book a demo</div>
    <span class="inline-flex items-center h-4 px-1.5 rounded text-[10px] font-medium shrink-0 bg-emerald-50 text-emerald-700">published</span>
    <div class="flex-1"></div>
    <span class="hidden sm:inline-flex items-center gap-1.5 h-7 px-2.5 rounded-md text-[12px] text-slate-600 shrink-0">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
      View live
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
    </span>
    <span class="h-7 px-2.5 rounded-md border border-slate-200 text-[12px] text-slate-600 inline-flex items-center shrink-0">Unpublish</span>
  </div>

  <!-- Tab bar -->
  <div class="shrink-0 px-3 flex items-center gap-1 border-b border-slate-200 bg-white overflow-x-auto">
    {tabs.map((t) => (
      <span class={`relative h-10 px-2.5 inline-flex items-center gap-1.5 text-[12.5px] shrink-0 ${t.on ? 'text-slate-900 font-medium' : 'text-slate-500'}`}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={t.icon}></svg>
        {t.label}
        {t.badge && <span class="inline-flex items-center h-4 px-1 rounded bg-sky-50 text-sky-700 text-[10px] font-medium tabular-nums">{t.badge}</span>}
        {t.on && <span class="absolute left-1.5 right-1.5 -bottom-px h-0.5 rounded-full bg-sky-600"></span>}
      </span>
    ))}
  </div>

  <!-- Body -->
  <div class="flex-1 min-h-0 flex">
    <aside class="flex w-52 shrink-0 flex-col gap-3 border-r border-slate-200 bg-white overflow-y-auto p-3">
      {[{ group: 'Fields', items: paletteFields }, { group: 'Layout', items: paletteLayout }].map((g) => (
        <div>
          <div class="text-[10px] uppercase tracking-[0.14em] text-slate-400 font-medium px-2 mb-1">{g.group}</div>
          <div class="flex flex-col">
            {g.items.map((it) => (
              <span class="h-8 px-2 w-full inline-flex items-center gap-2 rounded-md text-[12px] text-slate-700">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400" set:html={it.icon}></svg>
                {it.label}
              </span>
            ))}
          </div>
        </div>
      ))}
      <p class="text-[10.5px] text-slate-400 px-2">Click to add, or drag onto the canvas.</p>
    </aside>

    <!-- Canvas: the live .wf renderer, split layout, on its own page background -->
    <div class="flex-1 min-w-0 overflow-hidden relative flex [&>*]:flex-1" style="background:#f8fafc;">
      <FormCardMock selected="em" />
    </div>

    <!-- Field settings for the selected field -->
    <aside class="w-80 shrink-0 border-l border-slate-200 bg-white overflow-y-auto">
      <div class="flex flex-col gap-4 p-4">
        <div class="flex items-center gap-2">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-sky-600"><circle cx="12" cy="12" r="4"/><path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-4 8"/></svg>
          <span class="text-[10px] uppercase tracking-[0.14em] text-slate-400 font-medium">Email</span>
        </div>
        <div>
          <div class={label}>Label</div>
          <div class={field}>Work email</div>
        </div>
        <div>
          <div class={label}>Placeholder</div>
          <div class={field}>you@company.com</div>
        </div>
        <div>
          <div class={label}>Help text</div>
          <div class={field}><span class="text-slate-400">Shown under the field</span></div>
        </div>
        <div class="min-w-0 flex flex-col gap-2.5 sm:flex-row sm:items-start sm:justify-between sm:gap-5">
          <div>
            <div class="text-[12.5px] text-slate-900 font-medium">Required</div>
            <p class="text-[11px] text-slate-500 mt-0.5 leading-relaxed">Visitors cannot submit without answering.</p>
          </div>
          <span class="relative inline-flex h-[18px] w-8 shrink-0 items-center rounded-full bg-sky-600 transition-colors"><span class="inline-block size-3.5 translate-x-[15px] rounded-full bg-white shadow-sm"></span></span>
        </div>
        <div>
          <div class={label}>Width</div>
          <div class="inline-flex items-center gap-0.5 rounded-md border border-slate-200 bg-white p-0.5">
            <span class="h-6 px-2.5 rounded text-[11.5px] font-medium transition-colors bg-sky-600 text-white inline-flex items-center">Full</span>
            <span class="h-6 px-2.5 rounded text-[11.5px] font-medium transition-colors text-slate-500 inline-flex items-center">Half</span>
          </div>
        </div>
        <div>
          <div class={label}>Saves to contact</div>
          <div class="h-7 px-2.5 rounded-md border border-slate-200 bg-white text-[12px] text-slate-700 flex w-full items-center gap-1.5 transition-colors opacity-60">
            <span class="truncate flex-1 text-left">Email</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 shrink-0"><path d="m6 9 6 6 6-6"/></svg>
          </div>
          <p class="text-[11px] text-slate-500 mt-1">The email field always fills the contact's email.</p>
        </div>
      </div>
    </aside>
  </div>
</div>
