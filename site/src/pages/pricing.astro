---
import Layout from '../layouts/Layout.astro';
import HeroAtmosphere from '../components/HeroAtmosphere.astro';
import Cloud from '../components/Cloud.astro';
import Icon from '../components/Icon.astro';

// Mirrors web/src/lib/plans.ts and the pricing panel on index.astro.
const plans = [
  {
    name: 'Starter',
    price: '$29',
    annual: '$23',
    summary: 'For small teams getting started with cold outreach.',
    sendsPerDay: 150,
    href: 'https://app.warmbly.com/register?plan=starter',
    cta: 'Start free',
    highlight: false,
    // Annual is 20% off, so the yearly saving is (monthly - annual) * 12.
    save: '$72',
    // Log-scaled so 150 -> 15,000 stays legible as a bar.
    meter: 47,
    // Daily volume is the headline number on the card, so it is deliberately
    // not repeated as a bullet here.
    features: [
      'Unlimited warmup',
      'Unlimited mailboxes',
      'Unified inbox with reply detection',
      'Sequences that stop on reply',
      'Inbox placement monitoring',
    ],
  },
  {
    name: 'Grow',
    price: '$89',
    annual: '$71',
    summary: 'For teams scaling outreach across multiple senders.',
    sendsPerDay: 3000,
    href: 'https://app.warmbly.com/register?plan=grow',
    cta: 'Start free',
    highlight: false,
    save: '$216',
    meter: 76,
    features: [
      'Everything in Starter',
      'CRM with pipelines and deals',
      'A/B variants per step',
      'Bulk contact import',
      'API and signed webhooks',
      'Custom tracking domain',
    ],
  },
  {
    name: 'Business',
    price: '$329',
    annual: '$263',
    summary: 'For established teams with serious sending volume.',
    sendsPerDay: 15000,
    href: 'https://app.warmbly.com/register?plan=business',
    cta: 'Start free',
    highlight: true,
    save: '$792',
    meter: 91,
    // Not an IP product: the plan reserves the address the mailboxes sign IN
    // from (plan.IsolatedEgress()), which is what earns sign-in trust and keeps
    // a noisy neighbour from triggering a shared per-IP auth throttle.
    features: [
      'Everything in Grow',
      'Your mailboxes sign in from an address no one else uses',
      'Team roles and permissions',
      'Full audit log',
      'Priority support',
    ],
  },
  {
    name: 'Enterprise',
    price: 'Custom',
    annual: 'Custom',
    summary: 'Custom volume and dedicated support.',
    sendsPerDay: Infinity,
    href: '/contact/?topic=sales',
    cta: 'Talk to sales',
    highlight: false,
    save: '',
    meter: 100,
    features: [
      'Everything in Business',
      'Custom volume and contract',
      'BYOK encryption · SSO / SAML',
      'Custom data residency',
      'Dedicated CSM and SLA',
    ],
  },
];

// The self-hosted warmup pool link, priced apart from the platform.
const poolTiers = [
  {
    name: 'Free',
    price: '$0',
    cadence: 'forever',
    summary: 'Up to 10 mailboxes warming with the free tier of the pool.',
    highlight: false,
    features: [
      'Partners drawn from other free mailboxes',
      'No card, no time limit',
      'Unenroll any mailbox any time',
    ],
  },
  {
    name: 'Premium',
    price: '$15',
    cadence: '/ month · or $144 a year',
    summary: 'Unlimited mailboxes in the premium pool, served first.',
    highlight: true,
    features: [
      'Unlimited mailboxes',
      'Premium pool: proven paying mailboxes as partners',
      'Better deliverability: spam rescue, replies, placement tracking',
      'Priority service, always served first',
    ],
  },
];

const selfHostFacts = [
  { value: '$0',        label: 'To self-host' },
  { value: 'Unlimited', label: 'Mailboxes' },
  { value: '1',         label: 'Command to install' },
  { value: '10',        label: 'Free pool mailboxes' },
];

const everyPlan = [
  { icon: 'flame',    label: 'Unlimited warmup' },
  { icon: 'inbox',    label: 'Unified inbox' },
  { icon: 'workflow', label: 'Sequences + branching' },
  { icon: 'shield',   label: 'Suppression handling' },
  { icon: 'send',     label: 'Native Gmail + Outlook' },
  { icon: 'database', label: 'Unlimited contacts' },
];

const matrix = [
  {
    group: 'Sending',
    rows: [
      ['Connected mailboxes',       'Unlimited',  'Unlimited',   'Unlimited',   'Unlimited'],
      ['Cold sends per day',        '150',        '3,000',       '15,000',      '15,000+'],
      ['Per-mailbox cold cap',      '100 / day',  '100 / day',   '100 / day',   'Custom'],
      ['Distributed workers',       'Shared',     'Shared',      'Dedicated',   'Dedicated'],
      ['Sending kept apart from others', '—',      '—',           '✓',           '✓'],
    ],
  },
  {
    group: 'Deliverability',
    rows: [
      ['Warmup',                    'Unlimited',  'Unlimited',   'Unlimited',   'Unlimited'],
      ['Warmup pool',               'Premium',    'Premium',     'Premium',     'Premium'],
      ['Reply detection',           '✓',          '✓',           '✓',           '✓'],
      ['Suppression lists',         '✓',          '✓',           '✓',           '✓'],
    ],
  },
  {
    group: 'CRM & workflow',
    rows: [
      ['Pipelines · deals · tasks', '—',          '✓',           '✓',           '✓'],
      ['Team roles + audit log',    '—',          '—',           '✓',           '✓'],
    ],
  },
  {
    group: 'Platform',
    rows: [
      ['API & webhooks',            '—',          '✓',           '✓',           '✓'],
      ['SSO / SAML',                '—',          '—',           '—',           '✓'],
      ['Support',                   'Community',  'Email',       'Priority',    'Dedicated'],
    ],
  },
];

const headers = ['Starter', 'Grow', 'Business', 'Enterprise'];

const gh = '<path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.8 10.9.6.1.8-.2.8-.5v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.4-2.3 1.2-3.2-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2 1-.3 2-.4 3-.4s2 .1 3 .4c2.3-1.5 3.3-1.2 3.3-1.2.7 1.6.2 2.9.1 3.1.8.8 1.2 1.9 1.2 3.2 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.5 4.6-1.5 7.8-5.8 7.8-10.9C23.5 5.7 18.3.5 12 .5z"/>';
---
<Layout
  title="Pricing - Unlimited Mailboxes & Warmup | Warmbly"
  description="Self-host Warmbly for free and link it to the Warmbly warmup pool. Hosted plans are mailbox-based, with unlimited mailboxes and unlimited warmup."
>
  <!-- ============================================================
       HERO — same HeroAtmosphere as home, pricing-specific copy
              + toggle. The plan panel floats over the sky-to-white
              boundary below, the same way the home page does it.
  ============================================================ -->
  <section class="relative isolate overflow-hidden">
    <HeroAtmosphere />

    <div class="container-page relative pt-16 md:pt-24 pb-44 md:pb-52 text-center">
      <div class="inline-flex items-center gap-2 h-7 pl-1 pr-3 rounded-full bg-white/15 backdrop-blur ring-1 ring-white/25 text-[12px] text-white/95 shadow-[0_4px_14px_-4px_rgba(0,0,0,0.25)]">
        <span class="inline-flex items-center h-5 px-1.5 rounded-full text-[10.5px] font-semibold uppercase tracking-[0.06em] bg-white text-[color:var(--sky-6)]">
          Free to self-host
        </span>
        <span class="hidden sm:inline">Every hosted workspace starts free · link your own instance for warmup</span>
        <span class="sm:hidden">Every hosted workspace starts free</span>
      </div>

      <h1 class="mt-8 md:mt-10 text-[44px] sm:text-6xl md:text-[72px] lg:text-[80px] font-semibold tracking-[-0.04em] leading-[0.98] text-white max-w-4xl mx-auto">
        Honest pricing,<br/>built for senders.
      </h1>

      <p class="mt-6 text-[17px] md:text-[19px] text-white/80 max-w-2xl mx-auto leading-relaxed">
        Pay for the daily send volume you actually use. Unlimited mailboxes, unlimited warmup, on every paid plan.
      </p>

      <!-- Translucent toggle that reads as a control panel sitting on the sky. -->
      <div class="mt-9 inline-flex items-center gap-3" data-billing-toggle>
        <div class="relative inline-flex items-center p-1 rounded-full bg-white/10 backdrop-blur ring-1 ring-white/25 text-[13px] font-medium shadow-[0_4px_14px_-4px_rgba(0,0,0,0.25)]">
          <span class="billing-indicator absolute top-1 bottom-1 rounded-full bg-white transition-all duration-[350ms] ease-[cubic-bezier(0.22,1,0.36,1)] pointer-events-none" style="width: 0; opacity: 0; box-shadow: 0 6px 18px -4px rgba(0,0,0,0.25);"></span>
          <button type="button" data-billing="monthly" class="billing-btn relative z-10 h-9 px-5 rounded-full min-w-[112px] transition-colors duration-200 text-white/70 hover:text-white">
            Monthly
          </button>
          <button type="button" data-billing="annual" class="billing-btn relative z-10 h-9 px-5 rounded-full min-w-[112px] transition-colors duration-200 text-[color:var(--sky-5)]" aria-pressed="true">
            Annual
          </button>
        </div>
        <span class="inline-flex items-center h-7 px-2.5 rounded-full text-[11.5px] font-semibold bg-white/10 backdrop-blur text-white border border-white/30">
          Save 20%
        </span>
      </div>
    </div>
  </section>

  <!-- ============================================================
       PLAN PANEL — one surface, four joined columns, pulled up
       over the hero. Same anatomy as the home page pricing panel.
  ============================================================ -->
  <section class="relative -mt-32 md:-mt-40 pb-16 md:pb-20 z-10">
    <div class="container-page">
      <!-- The featured plan is marked by a tint and a top accent rule rather
           than by elevation, so the row stays a single connected surface. -->
      <div class="rounded-[14px] bg-white ring-1 ring-[color:var(--border)] overflow-hidden shadow-[0_18px_50px_-28px_rgba(15,23,42,0.32)]">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
          {plans.map((p, idx) => (
            <div
              class:list={[
                'relative flex flex-col p-6 border-[color:var(--border)]',
                p.highlight && 'bg-[color:var(--surface-2)]',
                idx === 0 ? ''
                  : idx === 1 ? 'border-t sm:border-t-0 sm:border-l'
                  : idx === 2 ? 'border-t lg:border-t-0 lg:border-l'
                  : 'border-t lg:border-t-0 sm:border-l',
              ]}
            >
              {p.highlight && (
                <span class="absolute inset-x-0 top-0 h-[3px] bg-[color:var(--brand)]"></span>
              )}

              <div class="relative flex flex-col h-full">
                <div class="flex items-center justify-between gap-2 h-6">
                  <h2 class={`text-[13px] font-semibold uppercase tracking-[0.12em] ${p.highlight ? 'text-[color:var(--brand)]' : 'text-heading'}`}>{p.name}</h2>
                  {p.highlight && (
                    <span class="inline-flex items-center h-[22px] px-2 rounded-full text-[9.5px] font-semibold uppercase tracking-[0.10em] bg-[color:var(--brand)] text-white shadow-[0_4px_12px_-2px_rgba(2,132,199,0.55)] whitespace-nowrap">
                      Most popular
                    </span>
                  )}
                </div>
                <p class="mt-2 text-[12.5px] text-muted-foreground leading-snug min-h-[36px]">{p.summary}</p>

                <div class="mt-5 flex items-baseline gap-2">
                  <span class="text-[44px] font-semibold tracking-[-0.04em] text-heading leading-none flex items-baseline">
                    <span class="plan-price relative inline-block overflow-hidden h-[44px] align-baseline" data-monthly={p.price} data-annual={p.annual}>
                      <span class="plan-price-inner block leading-[44px]" style="transform: translateY(0)">{p.annual}</span>
                    </span>
                  </span>
                  {p.save && (
                    <span class="plan-swap text-[15px] text-muted-foreground/60 line-through" data-monthly="" data-annual={p.price}>{p.price}</span>
                  )}
                </div>
                <p class="mt-2 text-[11.5px] text-muted-foreground">
                  {p.save ? (
                    <span class="cadence" data-monthly="/ month · billed monthly" data-annual="/ month · billed yearly">/ month · billed yearly</span>
                  ) : (
                    <span>volume-based · contact sales</span>
                  )}
                </p>
                {/* Rendered even when empty so every card's CTA sits on the
                    same line; Enterprise has no yearly saving to show. */}
                <p class="mt-1.5 h-[18px]">
                  {p.save && (
                    <span
                      class="plan-swap inline-flex items-center px-1.5 py-0.5 rounded text-[10.5px] font-semibold bg-emerald-50 text-emerald-700 ring-1 ring-emerald-200"
                      data-monthly=""
                      data-annual={`Save ${p.save} a year`}
                    >Save {p.save} a year</span>
                  )}
                </p>

                {/* Daily send volume, the thing each tier actually buys. */}
                <div class="mt-5">
                  <div class="flex items-baseline justify-between text-[11px] mb-1.5">
                    <span class="font-mono text-heading">
                      {p.sendsPerDay === Infinity ? '15,000+' : p.sendsPerDay.toLocaleString()}
                    </span>
                    <span class="text-muted-foreground">sends / day</span>
                  </div>
                  <div class={`h-1 rounded-full overflow-hidden ${p.highlight ? 'bg-white' : 'bg-[color:var(--surface-2)]'}`}>
                    <span
                      class={`block h-full rounded-full ${p.highlight ? 'bg-[color:var(--brand)]' : 'bg-[color:var(--border-strong)]'}`}
                      style={`width:${p.meter}%`}
                    ></span>
                  </div>
                </div>

                <a
                  href={p.href}
                  class={`mt-6 inline-flex h-11 px-4 items-center justify-center w-full rounded-[10px] text-[14px] font-medium transition-colors ${
                    p.highlight
                      ? 'bg-[color:var(--brand)] text-white hover:bg-[color:var(--brand-strong)] shadow-[0_10px_24px_-10px_rgba(2,132,199,0.65)]'
                      : 'bg-foreground text-background hover:bg-foreground/85'
                  }`}
                >
                  {p.cta}
                </a>

                <div class="my-5 h-px bg-[color:var(--border)]"></div>
                <ul class="space-y-2.5 text-[13px] text-foreground/90">
                  {p.features.map((f) => (
                    <li class="flex items-start gap-2">
                      <span class={`mt-[3px] shrink-0 w-4 h-4 rounded-full inline-flex items-center justify-center ${p.highlight ? 'bg-[color:var(--brand)] text-white' : 'bg-[color:var(--surface-2)] text-foreground/55'}`}>
                        <Icon name="check" size={10} strokeWidth={2.5} />
                      </span>
                      <span>{f}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>

        <!-- The free workspace as a slim row on the same surface: it is real
             and it is how most people start, but it is not a sending tier. -->
        <div class="border-t border-[color:var(--border)] bg-[color:var(--surface-2)]/60 px-6 py-4 flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-6">
          <div class="flex items-center gap-3 shrink-0">
            <span class="text-[13px] font-semibold uppercase tracking-[0.12em] text-heading">Free</span>
            <span class="text-[22px] font-semibold tracking-[-0.03em] leading-none text-heading">$0</span>
          </div>
          <p class="text-[12.5px] text-muted-foreground leading-snug sm:flex-1">
            A hosted workspace with up to 10 mailboxes and warmup. No card, no time limit. Sending, the inbox and CRM unlock when you pick a plan.
          </p>
          <a href="https://app.warmbly.com/register" class="inline-flex items-center gap-1 text-[13px] font-medium text-[color:var(--brand)] hover:text-[color:var(--brand-strong)] whitespace-nowrap">
            Start free <Icon name="arrowRight" size={12} />
          </a>
        </div>
      </div>

      <p class="mt-8 text-center text-[12.5px] text-muted-foreground/85 max-w-2xl mx-auto leading-relaxed">
        Applicable taxes are calculated from your billing address and shown before you pay. Where supported, business buyers can add their legal name and tax ID at checkout.
      </p>
    </div>
  </section>

  <!-- ============================================================
       SELF-HOSTED — free platform, pool link priced separately.
       Copy on the left; on the right a panel with the same anatomy
       as the plan panel: two joined pool tiers over an install
       terminal, so the whole page reads as one pricing system.
  ============================================================ -->
  <section class="relative py-20 md:py-28 border-t border-[color:var(--border)] overflow-hidden">
    <div class="absolute -top-6 right-[-90px] w-[300px] opacity-25 pointer-events-none cloud-drift cloud-2" style="mix-blend-mode: multiply;">
      <Cloud variant={4} opacity={0.6} />
    </div>
    <div class="container-page relative grid lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      <div class="lg:col-span-5">
        <a
          href="https://github.com/warmbly/warmbly"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 h-7 pl-2.5 pr-1.5 rounded-full bg-white ring-1 ring-[color:var(--border)] text-[12px] font-medium text-heading shadow-[0_2px_10px_-4px_rgba(15,23,42,0.2)] hover:ring-[color:var(--border-strong)] transition-colors"
        >
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" set:html={gh}></svg>
          Self-hosted
          <span class="inline-flex items-center h-[18px] px-1.5 rounded-full text-[9.5px] font-semibold uppercase tracking-[0.06em] bg-[color:var(--brand-soft)] text-[color:var(--brand-strong)]">Apache 2.0</span>
        </a>

        <h2 class="mt-5 text-[32px] md:text-[44px] font-semibold tracking-[-0.03em] leading-[1.04] text-heading">
          Free to run.<br/>We handle the warmup.
        </h2>
        <p class="mt-4 text-[15px] text-foreground/75 leading-relaxed max-w-xl">
          The whole platform costs nothing to self-host. When Warmbly Cloud launches, link your instance from Settings and the
          mailboxes you choose warm up in the shared pool, with thousands of real mailboxes sending, replying and rescuing from spam.
          Campaigns, contacts and inbox never leave your server.
        </p>

        <div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-y-5">
          {selfHostFacts.map((f, i) => (
            <div class:list={['pr-4', i > 0 && 'sm:border-l sm:border-[color:var(--border)] sm:pl-4']}>
              <div class="text-[22px] font-semibold tracking-[-0.02em] leading-none text-heading">{f.value}</div>
              <div class="mt-1.5 text-[10px] uppercase tracking-[0.14em] font-mono text-muted-foreground">{f.label}</div>
            </div>
          ))}
        </div>

        <ul class="mt-8 space-y-2.5 text-[13.5px] text-foreground/85">
          <li class="flex items-start gap-2.5">
            <span class="mt-[3px] shrink-0 w-4 h-4 rounded-full inline-flex items-center justify-center bg-[color:var(--brand-soft)] text-[color:var(--brand-strong)]"><Icon name="check" size={10} strokeWidth={2.5} /></span>
            Link in about a minute with a one-time code
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[3px] shrink-0 w-4 h-4 rounded-full inline-flex items-center justify-center bg-[color:var(--brand-soft)] text-[color:var(--brand-strong)]"><Icon name="check" size={10} strokeWidth={2.5} /></span>
            Only the mailbox credential travels, encrypted, for warmup
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[3px] shrink-0 w-4 h-4 rounded-full inline-flex items-center justify-center bg-[color:var(--brand-soft)] text-[color:var(--brand-strong)]"><Icon name="check" size={10} strokeWidth={2.5} /></span>
            Unenroll or disconnect any time; the cloud forgets it immediately
          </li>
        </ul>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="https://app.warmbly.com" class="inline-flex h-11 px-5 items-center gap-2 rounded-[10px] text-[14px] font-medium bg-foreground text-background hover:bg-foreground/85 transition-colors">
            Join the cloud waitlist <Icon name="arrowRight" size={14} />
          </a>
          <a href="https://docs.warmbly.com/development/install/" class="inline-flex h-11 px-5 items-center rounded-[10px] text-[14px] font-medium text-heading bg-white ring-1 ring-[color:var(--border)] hover:ring-[color:var(--border-strong)] transition-colors">
            Self-host guide
          </a>
        </div>
      </div>

      <div class="lg:col-span-7">
        <div class="rounded-[14px] bg-white ring-1 ring-[color:var(--border)] overflow-hidden shadow-[0_18px_50px_-28px_rgba(15,23,42,0.32)]">
          <div class="px-6 py-4 border-b border-[color:var(--border)] flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
            <div>
              <div class="text-[10.5px] uppercase tracking-[0.18em] font-mono text-muted-foreground">Warmup pool link</div>
              <div class="mt-1 text-[14px] font-semibold text-heading">Free to start. Pay for the premium pool and better deliverability.</div>
            </div>
            <span class="inline-flex items-center gap-1.5 h-6 px-2.5 rounded-full text-[10.5px] font-semibold bg-[color:var(--brand-soft)] text-[color:var(--brand-strong)] whitespace-nowrap">
              <span class="w-1.5 h-1.5 rounded-full bg-[color:var(--brand)]"></span>
              Arrives with Warmbly Cloud
            </span>
          </div>

          <div class="grid sm:grid-cols-2">
            {poolTiers.map((t, idx) => (
              <div
                class:list={[
                  'relative flex flex-col p-6 border-[color:var(--border)]',
                  t.highlight && 'bg-[color:var(--surface-2)]',
                  idx > 0 && 'border-t sm:border-t-0 sm:border-l',
                ]}
              >
                {t.highlight && (
                  <span class="absolute inset-x-0 top-0 h-[3px] bg-[color:var(--brand)]"></span>
                )}
                <div class="flex items-center justify-between gap-2 h-6">
                  <h3 class={`text-[13px] font-semibold uppercase tracking-[0.12em] ${t.highlight ? 'text-[color:var(--brand)]' : 'text-heading'}`}>{t.name}</h3>
                  {t.highlight && (
                    <span class="inline-flex items-center h-[22px] px-2 rounded-full text-[9.5px] font-semibold uppercase tracking-[0.10em] bg-[color:var(--brand)] text-white shadow-[0_4px_12px_-2px_rgba(2,132,199,0.55)] whitespace-nowrap">
                      Recommended
                    </span>
                  )}
                </div>
                <p class="mt-2 text-[12.5px] text-muted-foreground leading-snug min-h-[36px]">{t.summary}</p>
                <div class="mt-4 flex items-baseline gap-2">
                  <span class="text-[36px] font-semibold tracking-[-0.04em] text-heading leading-none">{t.price}</span>
                  <span class="text-[11.5px] text-muted-foreground">{t.cadence}</span>
                </div>
                <div class="my-5 h-px bg-[color:var(--border)]"></div>
                <ul class="space-y-2.5 text-[13px] text-foreground/90">
                  {t.features.map((f) => (
                    <li class="flex items-start gap-2">
                      <span class={`mt-[3px] shrink-0 w-4 h-4 rounded-full inline-flex items-center justify-center ${t.highlight ? 'bg-[color:var(--brand)] text-white' : 'bg-[color:var(--surface-2)] text-foreground/55'}`}>
                        <Icon name="check" size={10} strokeWidth={2.5} />
                      </span>
                      <span>{f}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>

          <!-- The install itself: one command, no clone, no compiler. -->
